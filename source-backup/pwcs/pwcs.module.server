/**
 * Implementation of hook_perm().
 * Added by Rasel Kabir
 */
function pwcs_perm() {

	$perms = array();
	$perms = array_merge($perms, pwcs_user_perm());
	$perms = array_merge($perms, pwcs_product_perm());
	return $perms;
}

/**
 * Implementation of hook_init().
 * Added by Rasel Kabir
 */
function pwcs_init() {

	// pwcs can not work without this variable.
	if ( ((variable_get('pwcs_pwc_core_url', '')) == '')  || ((variable_get('pwcs_target_url_categorylist', '')) == '') || ((variable_get('pwcs_target_url_productlist', '')) == '')) {
		drupal_set_message(t('Missing necessary URLs, Please set the variables URL at <a href="@settings">pwcs settings</a>.', array('@settings' => url('admin/settings/pwcs'))), 'error');
	}
}

/**
 * Implementation of hook_menu().
 * Added by Rasel Kabir
 */
function pwcs_menu() {

	$items = array();
	include_once(drupal_get_path('module', 'pwcs').'/pwcs_navigation.php');
	$items = pwcs_siteadmin_url_items();
	return $items;
}

