				''=>'<em>'.t('No Icon').'</em>', 
				'auto_thumb'=> theme('image', PWCS_MODULE_IMAGE.'video_thumb_default.jpg', '', '', array('width'=>'auto'), FALSE).' ('.t('Auto Generated Thumbnail').')'
