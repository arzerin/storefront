/**
 * Implementing hook_form_alter()
 * Added by Rasel Kabir
 */
function pwcs_form_alter(&$form, $form_state, $form_id)
{
	global $user;

	//print_r ($form_id);

	if ($user->uid != 1) {
		unset($form['locale']);
	}

	if(isset($form['buttons']['preview']))
		$form['buttons']['preview']['#type'] = 'hidden';

	if(isset($form['preview']))
		$form['preview']['#type'] = 'hidden';

	if ($user->uid != 1) {
		$form['submit']['#prefix'] = '<div style="height:10px;"> </div>';
		$form['submit']['#suffix'] = '';
	}

	switch ($form_id)
	{
		case 'user_login':
			unset($form['name']['#description']);
			unset($form['pass']['#description']);
		break;

		case 'user_register':
		case 'user_profile_form':
		case 'user_edit':

			//unset($form['account']);
			if ($user->uid != 1) {
				unset($form['account']['status']);
				unset($form['timezone']);
				unset($form['delete']);
			}

		break;

		case 'block_admin_display_form':

			if ($user->uid != 1) {

				//$siteadmin_block_page = '<a href="javascript: history.go(-1); reload();"></a>';
				$back_to_admin_panel = l('Admin Panel','siteadmin/theme', array('attributes'=>array('class'=>'return')));
				$add_new_block = l('Add Block','admin/build/block/add', array('attributes'=>array('class'=>'addblock')));

				$js='$(function() {'.
							'$("body").append('.
							'\'<div class="siteadmin-floating-navigation">'.
							'<div class="bg-top"></div>'.
							'<div class="bg-mid">'.
							$back_to_admin_panel.
							$add_new_block.
							'</div>'.
							'<div class="bg-bottom"></div>'.
							'</div>\''
							.');'.

							'$("#content-tabs").hide();'.
							'$(".help").hide();'.
						'});';
				drupal_add_js($js, 'inline', 'footer');


			    unset($form['user_0']); //User login
			    unset($form['user_1']);
			    unset($form['user_2']);
			    unset($form['user_3']);
			    unset($form['menu_admin']);
			    unset($form['system_0']);
			    unset($form['comment_0']);
			    unset($form['statistics_0']);
			    unset($form['node_0']);
			    unset($form['menu_primary-links']); //Primary links
			    unset($form['menu_secondary-links']); //Secondary links
			    unset($form['pwcs_siteadmin_navigation']);
			}
		break;

		case 'block_add_block_form':
		case 'block_admin_configure':

			if ($user->uid != 1) {

				$form['block_settings']['body_field']['format']['#prefix'] = '<div style="display:none;">';
				$form['block_settings']['body_field']['format']['#suffix'] = '</div>';

//				$form['block_settings']['title']['#prefix'] = '<div style="display:none;">';
//				$form['block_settings']['title']['#suffix'] = '</div>';

				$form['user_vis_settings']['#prefix'] = '<div style="display:none;">';
				$form['user_vis_settings']['#suffix'] = '</div>';

				$form['role_vis_settings']['#prefix'] = '<div style="display:none;">';
				$form['role_vis_settings']['#suffix'] = '</div>';

//				$form['page_vis_settings']['#prefix'] = '<div style="display:none;">';
//				$form['page_vis_settings']['#suffix'] = '</div>';

				$form['page_vis_settings']['#collapsed'] = 1;
				$form['page_vis_settings']['pages']['#description'] = t('Enter one url per line as paths without base url ('.PWCS_STORE_URL.'). ' .
																		'The \'*\' character is a wildcard. ' .
																		'Example paths are <em>blog</em> for the blog page ' .
																		'and <em>blog/*</em> for every personal blog. ' .
																		'<em>&lt;front&gt;</em> is the front page.'
																		);
		}

		break;

		case 'product_node_form':

			if ($user->uid != 1) {
				//echo '<pre>'.print_r ($form, true).'</pre>';

				$form['menu']['#prefix'] = '<div style="display:none;">';
				$form['menu']['#suffix'] = '</div>';

				$form['comment_settings']['#prefix'] = '<div style="display:none;">';
				$form['comment_settings']['#suffix'] = '</div>';

				//Path
				$form['path']['#prefix'] = '<div id="product_path">';
				$form['path']['#suffix'] = '</div>';
				$form['path']['#collapsible'] = 0;
				$form['path']['#collapsed'] = 0;
	
				//Buttons
				$form['buttons']['#prefix'] = '<div id="product_buttons" class="add_edit_products_buttons">';
				$form['buttons']['#suffix'] = '</div>';
				$form['buttons']['#weight'] = -100;
			}

		break;

		case 'page_node_form':
			if ($user->uid != 1) {
			$form['menu']['#weight'] = 29;
			$form['menu']['#collapsed'] = 0;
      //unset($form['menu']['parent']['#options']['admin:0']);
			$form['title']['#title'] = t('Page title');
			$form['body_field']['body']['#title'] = t('Page Body');
			$form['body_field']['format']['#prefix'] = '<div style="display:none;">';
			$form['body_field']['format']['#suffix'] = '</div>';
			}
		break;

		case 'system_site_information_settings':
			if ($user->uid != 1) {
				unset($form['anonymous']);
				//unset($form['site_frontpage']);
			}
		break;

		case 'imce_upload_form':
			if ($user->uid != 1) {
				drupal_set_title('Media Manager');
			}
		break;

		case 'system_theme_settings':

			if ($user->uid != 1) {

				drupal_set_title('Theme Configuration');
				$js='$(function() {
						$(".tabs").hide();
						$(".help").hide();
				});';
				drupal_add_js($js, 'inline', 'footer');

				//$config_theme_id = $form['#parameters']['2'];
			  //if ($user->uid > 0 && user_access('is siteadmin')) {
	  		//  variable_set('theme_default', $config_theme_id);
			  //}
//
//				if($form['#parameters']['2'] == 'pwcs_default') {
//					$form_theme_specific = array();
//					unset($form['theme_specific']['tnt_container']['general_settings']['theme_grid_config']['theme_grid']);
//					unset($form['theme_specific']['tnt_container']['general_settings']['theme_grid_config']['fluid_grid_width']);
//					$form_theme_specific[] = $form['theme_specific']['tnt_container']['general_settings']['theme_grid_config'];
//
//					//$form['theme_specific']['tnt_container']['general_settings']['theme_font_config']['theme_font_config_font']['theme_font']['#type'] = 'select';
//					$form['theme_specific']['tnt_container']['general_settings']['theme_font_config']['theme_font_config_size']['theme_font_size']['#type'] = 'select';
//
//					$form_theme_specific[] = $form['theme_specific']['tnt_container']['general_settings']['theme_font_config']['theme_font_config_font'];
//					$form_theme_specific[] = $form['theme_specific']['tnt_container']['general_settings']['theme_font_config']['theme_font_config_size'];
//					$form_theme_specific[] = $form['theme_specific']['tnt_container']['general_settings']['navigation']['breadcrumb'];
//					unset($form['theme_specific']);
//					foreach ($form_theme_specific as $k=>$v){
//						$form_theme_specific[$k]['#collapsed'] = 0;
//					}
//					$form['theme_specific'] = $form_theme_specific;
//					$form['buttons']['#weight'] = 100;
//				}

			}
		break;

		case 'image_slideshow_node_form':

			if ($user->uid != 1) {
				if ($form['#node']->path == 'siteadmin/imageslideshow') {

					$js='$(function() {
							$("#center ul.tabs").hide();
							$("#center div.help").hide();
					});';
					drupal_add_js($js, 'inline', 'footer');


					//echo '<pre>'.print_r ($form['field_slideshow_images'], true).'</pre>';

					$form['title']['#prefix'] = '<div style="display:none;">';
					$form['title']['#suffix'] = '</div>';

					$form['body_field']['#prefix'] = '<div style="display:none;">';
					$form['body_field']['#suffix'] = '</div>';

					$form['path']['#prefix'] = '<div style="display:none;">';
					$form['path']['#suffix'] = '</div>';

					$form['field_slideshow_images']['field_slideshow_images_add_more']['#value'] = t('Add Another Image');

					$form['buttons']['#prefix'] = '<div style="margin: 20px 0; padding: 10px 0; border-top: 1px solid #ddd;">';
					$form['buttons']['#suffix'] = '</div>';
				}
			}
			
		break;

		case 'comment_form':

			if ($user->uid != 1) {
				if($form['nid']['#value']) {
					$type = db_result(db_query('SELECT type from {node} WHERE nid = %d', $form['nid']['#value']));
					
					if($type == 'product') {
						
						$form['#redirect'] = array('node/'.$form['nid']['#value']);

						$form['homepage']['#prefix'] = '<div style="display:none;">';
						$form['homepage']['#suffix'] = '</div>';

						$form['comment_filter']['format']['#prefix'] = '<div style="display:none;">';
						$form['comment_filter']['format']['#suffix'] = '</div>';
	
						$form['submit']['#value'] = t('Add Review');
						$form['submit']['#prefix'] = '<div class="review_button">';
						$form['submit']['#suffix'] = '</div>';
					}
				}					
			}
			
		break;

		case 'fivestar_settings':

			if ($user->uid != 1) {

				$form['widget']['fivestar_color_widget']['#prefix'] = '<div style="display:none;">';
				$form['widget']['fivestar_color_widget']['#suffix'] = '</div>';
				$form['color']['#prefix'] = '<div style="display:none;">';
				$form['color']['#suffix'] = '</div>';
			}
			
		break;

		case 'menu_overview_form':

			drupal_set_title(t('Site Menu Items'));
			//print_r ($form);
			if ($user->uid != 1) {
				$js='$(function() {
						$("#tabs-wrapper ul.tabs li:nth-child(3)").hide();
						$("table#menu-overview thead th:nth-child(3)").hide();
						$("table#menu-overview tbody td:nth-child(3)").hide();
				});';
				drupal_add_js($js, 'inline', 'footer');
			}
			
		break;

		case 'menu_edit_item':

			if ($user->uid != 1) {
				$js='$(function() {
						$("#tabs-wrapper ul.tabs li:nth-child(3)").hide();
				});';
				drupal_add_js($js, 'inline', 'footer');

				$form['menu']['description']['#prefix'] = '<div style="display:none;">';
				$form['menu']['description']['#suffix'] = '</div>';
				$form['menu']['enabled']['#prefix'] = '<div style="display:none;">';
				$form['menu']['enabled']['#suffix'] = '</div>';
				$form['menu']['expanded']['#prefix'] = '<div style="display:none;">';
				$form['menu']['expanded']['#suffix'] = '</div>';
				$form['menu']['parent']['#prefix'] = '<div style="display:none;">';
				$form['menu']['parent']['#suffix'] = '</div>';
				$form['menu']['weight']['#prefix'] = '<div style="display:none;">';
				$form['menu']['weight']['#suffix'] = '</div>';
			}
			
		break;

	}
}

/**
 * Implementation of hook_theme
 * Added by Rasel Kabir
 */
function pwcs_theme() {
  $items = array();

  $items['pwcs_categorylist_sort_form'] = array(
    'arguments' => array('form' => NULL),
  );
  $items['pwcs_listing_sort_form'] = array(
    'arguments' => array('form' => NULL),
  );
  $items['pwcs_siteadmin_groups_form'] = array(
    'arguments' => array('form' => NULL),
  );
  $items['pwcs_siteadmin_product_order_form'] = array(
    'arguments' => array('form' => NULL),
  );
  $items['pwcs_siteadmin_att_groups_form'] = array(
    'arguments' => array('form' => NULL),
  );

  $items['pwcs_siteadmin_block_form'] = array(
    'arguments' => array('form' => NULL),
  );

/*  $items['macromaker_popup'] = array(
    'arguments' => array('items' => array()),
  );
*/
  return $items;
}

