	);

	$form['bottom']['#type'] = 'item';
	$form['bottom']['#prefix'] = '';
	$form['bottom']['#suffix'] = '<div style="padding:10px;"></div>';

	return system_settings_form($form);
}
function pwcs_sync()
{
	global $user,$finalmsgs;
	

	$finalmsgs = array();

	cache_clear_all();
  	drupal_flush_all_caches();


	$merchant_id='';
	$api_key='';

	$sql  = "SELECT * FROM {pwcs_autosync} async";
	$results = db_query($sql);
	while($result = db_fetch_object($results))
	{
		$merchant_id         = $result->merchantid;
		$api_key             = $result->apisignature;
		$merchantfirstname   = $result->merchantfirstname;
		$merchantlastname    = $result->merchantlastname;
		$merchantemail       = $result->merchantemail;
		$merchantcompanyname = $result->merchantcompanyname;
		$merchantwebaddress  = $result->merchantwebaddress;
		$merchantsubdomain   = $result->merchantsubdomain;
	}

	
	if ( (!empty($merchant_id)) && (!empty($api_key)) )
	{
		
		syncBasicSettings($merchant_id, $api_key);
		syncCategory($merchant_id, $api_key);
		syncListing($merchant_id, $api_key);
		syncProducts($merchant_id, $api_key);
		syncAttributes($merchant_id, $api_key);
		syncManufacturer($merchant_id, $api_key);
		syncProductsWithListing();
		pwcs_update_listing_table();
	}
	
	if (!empty($merchantsubdomain))
	variable_set('file_directory_path', 'sites/'.$merchantsubdomain.'.pwcstores.com/files');

	if (!empty($merchantcompanyname))
	variable_set('site_name', $merchantcompanyname.' Store');

	if (!empty($merchantemail))
	variable_set('site_mail', $merchantemail);

	if(!empty($merchantcompanyname))
	variable_set('site_footer', 'copyright @ '.date('Y').', '.$merchantcompanyname.'');
	else
	variable_set('site_footer', 'copyright @ '.date('Y').', Premium Web Cart Inc.');

	if(!empty($merchantlastname))
		$merchantusername = strtolower($merchantlastname);
	else if(!empty($merchantfirstname))
		$merchantusername = strtolower($merchantfirstname);
	else
		$merchantusername = 'demo';

	if(!empty($merchantlastname))
		$merchantname = $merchantlastname;
	else if(!empty($merchantfirstname))
		$merchantname = $merchantfirstname;
	else
		$merchantname = 'Merchant';

	$updateemail = db_query("UPDATE {users} SET name='".$merchantusername."', mail='".$merchantemail."',init='".$merchantemail."',merchant_enc_id='".$merchant_id."',site_api_key='".$api_key."' WHERE uid = '2'");

	
	
	$message = array(
	  'to' => $merchantemail,
	  'subject' => t('Your PWC Store Account has been Created'),
	  'body' => 'Dear '.$merchantname.'<br/><br/> Your Store Account has been Created Successfully.<br/><br/>Your Store URL: http://'.$merchantsubdomain.'.pwcstores.com/<br/><br/><br/>Your Store Admin URL: http://'.$merchantsubdomain.'.pwcstores.com/user<br/><br/>User Name: '.$merchantusername.'<br/>Password: 654321<br/><br/><br/>Thanks<br/>Premium Web Cart Inc. Team',
	  'headers' => array(
          'From' => 'webmaster@pwcart.com',
          'MIME-Version' => '1.0',
          'Content-Type' => 'text/html;charset=utf-8',),
          'Reply-To' => 'webmaster@pwcart.com',
	);

	drupal_mail_send($message);
	
	$message = array(
	  'to' => 'a.r.zerin@athena-soft.com',
	  'subject' => t('A Merchant PWC Store Account has been Created'),
	  'body' => 'Dear ZERIN<br/> Merchant Name: '.$merchantname.'<br/><br/> Merchant Store Account has been Created Successfully.<br/><br/>Merchant Store URL: http://'.$merchantsubdomain.'.pwcstores.com/<br/><br/><br/>Merchant Store Admin URL: http://'.$merchantsubdomain.'.pwcstores.com/user<br/><br/>User Name: '.$merchantusername.'<br/>Password: 654321<br/><br/><br/>Thanks<br/>Premium Web Cart Inc. Team',
	  'headers' => array(
          'From' => 'webmaster@pwcart.com',
          'Reply-To' => 'webmaster@pwcart.com',
          'MIME-Version' => '1.0',
          'Content-Type' => 'text/html;charset=utf-8',),
	);

	drupal_mail_send($message);		
	


	
	$message = array(
	  'to' => 'a.r.zerin@athena-soft.com',
	  'subject' => t('A PWC Store Account has been Created'),
	  'body' => 'Dear '.$merchantname.'<br/><br/> Your Store Account has been Created Successfully.<br/><br/>Your Store URL: http://'.$merchantsubdomain.'.pwcstores.com/<br/><br/><br/>Your Store Admin URL: http://'.$merchantsubdomain.'.pwcstores.com/user<br/><br/>User Name:'.$merchantusername.'<br/>Password:654321<br/><br/><br/>Thanks<br/>Premium Web Cart Inc. Team',
	  'headers' => array(
          'From' => 'webmaster@pwcart.com',
          'Reply-To' => 'webmaster@pwcart.com',
          'MIME-Version' => '1.0',
          'Content-Type' => 'text/html;charset=utf-8',),
	);

	drupal_mail_send($message);	

	die('DONE');
}
/**
 * API Function
 *
 * This function is called whenever any product is created or updated in PWCCORE
 * This function also get calls whenver any category is created or updated in PWCCORE
 *
 * @todo Currently we do not delete anything
 *       when a product or category will be deleted on PWCCORE
 *
 * @author A.R. ZERIN <a.r.zerin@gmail.com>
 * @version 1.0
 * @copyright
 * @package PWC Store
 * @link http://project_url/api/
 * @example http://www.pwcstores.com/api/
 * @access public
 * @param array [$type]
 * @see  $items['api']
 *
 * @global array $user
 *
 * @usedby api
 *
 * @last-modified on 26 October, 2010 by A.R. ZERIN <a.r.zerin@gmail.com>
 *
 * @return NULL, nothing to return
 *
 */
function pwcs_api($type = NULL){

	pwcs_debug_file_write($_REQUEST, true);

	global $user;
	$entity = isset($_REQUEST['entity']) ? $_REQUEST['entity'] : '';
	$status = isset($_REQUEST['status']) ? $_REQUEST['status'] : '';

	switch ($entity)
	{
		case 'product':     //If notification comes for Product

	    if($_POST['status'] == 'created' || $_POST['status'] == 'updated' || $_POST['status'] == 'deleted')
	    {
    	//Fetching all the data from POST Notification (Start)
        $product_row_id        = $_POST['product_row_id']        ? $_POST['product_row_id']        : '';
        $product_short_desc    = $_POST['shortDesc']             ? $_POST['shortDesc']             : '';
		$product_long_desc     = $_POST['longDesc']              ? $_POST['longDesc']              : '';
		$product_manufac_info  = $_POST['manufactureInfo']       ? $_POST['manufactureInfo']       : '';
		$product_manufac_id    = $_POST['manufacturer_id']       ? $_POST['manufacturer_id']       : 0;
        $product_link_id       = $_POST['link_id']               ? $_POST['link_id']               : '';
        $product_name          = $_POST['product_name']          ? $_POST['product_name']          : '';
        $product_sku           = $_POST['product_sku']           ? $_POST['product_sku']           : '';
        $product_category_id   = $_POST['category_id']           ? $_POST['category_id']           : '0';
        $product_price         = $_POST['price']                 ? $_POST['price']                 : '0.00';
        $regular_buy_link      = $_POST['regular_buy_link']      ? $_POST['regular_buy_link']      : '';
        $one_click_buy_link    = $_POST['one_click_buy_link']    ? $_POST['one_click_buy_link']    : '';
        $p_created_on          = $_POST['created_on']            ? $_POST['created_on']            : '0000-00-00';
        $p_modified_on         = $_POST['modified_on']           ? $_POST['modified_on']           : '0000-00-00';
        $product_image         = $_POST['product_image']         ? $_POST['product_image']         : '';
        
        $enable_sales_price    = $_POST['enable_sales_price']    ? $_POST['enable_sales_price']    : 0;
        $product_sale_price    = $_POST['product_sale_price']    ? $_POST['product_sale_price']    : 0;
        $sale_tag_icon         = $_POST['sale_tag_icon']         ? $_POST['sale_tag_icon']         : 0;
        $sale_price_start_date = $_POST['sale_price_start_date'] ? strtotime($_POST['sale_price_start_date']) : 0;
        $sale_price_end_date   = $_POST['sale_price_end_date']   ? strtotime($_POST['sale_price_end_date'])   : 0;
    	//Fetching all the data from POST Notification (End)


        //If there is not product_row_id, product_name, regular buy link & one click buy link then
        //we will not process
        if($product_row_id && $product_link_id && $product_name && $regular_buy_link && $one_click_buy_link)
        {
            // We have received notification after a product has been updated in PWCCORE
            if($_POST['status'] == 'updated')
            {
        	    //We are collecting node value for existing product from PWCSTORE
        	    $product_nid = db_result(db_query('SELECT nid FROM {pwcs_product} WHERE pwc_product_row_id = %d', $product_row_id));

            	    $node = node_load($product_nid);
				    $node->title                = stripslashes(mysql_escape_string($product_name));
				    $node->body                 = '';
				    $node->product_name         = stripslashes(mysql_escape_string($product_name));
				    $node->teaser               = $product_short_desc;
				    $node->body                 = $product_long_desc;
				    $node->product_manufacture  = $product_manufac_info;
				    $node->manufacturer_id      = $product_manufac_id;
				    $node->pwc_product_row_id   = $product_row_id;
				    $node->product_link_id      = $product_link_id;
				    $node->product_sku          = $product_sku;
				    $node->pwc_category_id      = $product_category_id;
				    $node->price          	    = $product_price;
				    $node->regular_buy_link     = $regular_buy_link;
				    $node->one_click_buy_link   = $one_click_buy_link;
				    //$node->product_image_path = $product_image;
				    $node->modified_on          = time();
				    $node->is_sync          	= 1;
				    $node->changed         	    = time();

					$node->sync_api          	= 1; // not for DB, status flag to detect node_save

					$node->issalespriceactive  = $enable_sales_price; 
					$node->salesprice          = $product_sale_price; 
					$node->salestag            = $sale_tag_icon; 
					$node->salepricestartdate  = $sale_price_start_date; 
					$node->salepriceenddate    = $sale_price_end_date; 
	

					node_save($node);
					pwcs_update_listing_table();
					pwcs_make_order_table();
            }//End of if($_POST['status'] == 'updated')

            // We have received notification after a new product has been created in PWCCORE
            if($_POST['status'] == 'created')
            {
					    $node = new stdClass();
					    $node->uid                  = $user->uid;
					    $node->type                 = 'product';
					    $node->title                = stripslashes(mysql_escape_string($product_name));
					    $node->product_name         = stripslashes(mysql_escape_string($product_name));
					    $node->teaser               = $product_short_desc;
					    $node->body                 = $product_long_desc;
					    $node->product_manufacture  = $product_manufac_info;
					    $node->manufacturer_id      = $product_manufac_id;
					    $node->pwc_product_row_id   = $product_row_id;
					    $node->product_link_id      = $product_link_id;
					    $node->product_sku          = $product_sku;
					    $node->pwc_category_id      = $product_category_id;
					    $node->price          	    = $product_price;
					    $node->regular_buy_link     = $regular_buy_link;
					    $node->one_click_buy_link   = $one_click_buy_link;
					    //$node->product_image_path   = $product_image;
					    $node->created_on           = time();
					    $node->modified_on          = time();
					    $node->is_sync          	= 1;
					    $node->changed         	    = time();

					    $node->sync_api          	= 1; // not for DB, status flag to detect node_save
					    
						$node->issalespriceactive  = $enable_sales_price; 
						$node->salesprice          = $product_sale_price; 
						$node->salestag            = $sale_tag_icon; 
						$node->salepricestartdate  = $sale_price_start_date; 
						$node->salepriceenddate    = $sale_price_end_date; 
					    
					    
			    		node_save($node);
			    		pwcs_update_listing_table();
			    		pwcs_make_order_table();
            }//End of if($_POST['status'] == 'created')
        }//End of  if($product_row_id && $product_link_id && $product_name && $regular_buy_link && $one_click_buy_link)
   	 	if($_POST['status'] == 'deleted')
    	{
    	  	$node_id =  pwcs_get_product_nid($product_row_id);
    	  	if($node_id >0)
    	  	node_delete($node_id);
			$sql = " DELETE FROM {pwcs_product} ".
		    	   " WHERE pwc_product_row_id	 = '%d' LIMIT 1";
	        db_query($sql,$product_row_id);
    	  	pwcs_make_order_table();
    	 }
    	}//if($_POST['status'] == 'created' || $_POST['status'] == 'updated' || $_POST['status'] == 'deleted')

		break;

		case 'category': //If notification comes for Category

	    if($_POST['status'] == 'created' || $_POST['status'] == 'updated')
	    {
	        $category_id         = $_POST['category_id']           ? $_POST['category_id']            : '';
	        $category_title      = $_POST['category_description']  ? $_POST['category_description']   : '';
	        $parent_category_id  = $_POST['parent_category_id']    ? $_POST['parent_category_id']     : 0;
	        $category_level      = $_POST['level']                 ? $_POST['level']                  : 0;
	        $has_child           = $_POST['has_child']             ? $_POST['has_child']              : 0;
	        $is_editable         = $_POST['is_editable']           ? $_POST['is_editable']            : 1;
	        $created_on          = $_POST['created_on']            ? $_POST['created_on']             : time();
	        $modified_on         = $_POST['modified_on']           ? $_POST['modified_on']            : time();

	            // We have received notification after a new category has been created in PWCCORE
	            if($_POST['status'] == 'created')
	            {
					$category=array();
					$category['category_title']     = stripslashes(mysql_escape_string($category_title));
					$category['parent_category_id'] = $parent_category_id;
					$category['weight']             = 0;
					$category['created_on']         = $created_on;

					$result = db_query("INSERT INTO {pwcs_category}" .
							" (`pwc_category_id`, `category_title`,`parent_category_id`,`weight`,`created_on`)" .
							" VALUES (%d, '%s', %d, %d, %d)",
							$category_id, $category_title, $parent_category_id, 0, $created_on
					);
					$result = db_query("INSERT INTO {pwcs_listings}" .
							" (`pwc_category_id`, `category_title`,`parent_category_id`,`category_type`, `is_editable`,`weight`,`created_on`)" .
							" VALUES (%d, '%s', %d, %d, %d, %d, %d)",
							$category_id, $category_title, $parent_category_id, 0, 1, 0, $created_on
					);
					pwcs_update_listing_table();
					pwcs_make_order_table();
	            }//End of if($_POST['status'] == 'created')

	            // We have received notification after an existing category has been updated in PWCCORE
	            if($_POST['status'] == 'updated')
	            {
					$category=array();
					$category['category_title']      = stripslashes(mysql_escape_string($category_title));
					$category['parent_category_id']  = $parent_category_id;
					$category['weight']              = 0;
					$category['created_on']          = $created_on;
					$category['modified_on']         = $modified_on;

					$result = db_query("UPDATE {pwcs_category}
						SET `category_title`='%s', `parent_category_id`= %d, `modified_on`=%d WHERE pwc_category_id = %d",
						$category['category_title'], $category['parent_category_id'], $category['modified_on'], $category_id
					);
					$result = db_query("UPDATE {pwcs_listings}
						SET `category_title`='%s', `parent_category_id`= %d, `modified_on`=%d WHERE pwc_category_id = %d",
						$category['category_title'], $category['parent_category_id'], $category['modified_on'], $category_id
					);
					pwcs_update_listing_table();
					pwcs_make_order_table();
	            }//End of if($_POST['status'] == 'updated')
	    }//if($_POST['status'] == 'created' || $_POST['status'] == 'updated')

		break;

		case 'manufacturer':

			 $manufacturer_id     = $_POST['manufacturer_id']   ? $_POST['manufacturer_id']    : '';
			 $manufacturer_name   = $_POST['manufacturer_name'] ? $_POST['manufacturer_name']  : '';
			 $created_on          = $_POST['created_on']        ? $_POST['created_on']         : time();
			 $modified_on         = $_POST['modified_on']       ? $_POST['modified_on']        : time();


		    if ($_POST['status'] == 'created' || $_POST['status'] == 'updated' || $_POST['status'] == 'deleted')
		    {
		    	 if($_POST['status'] == 'created')
		    	 {

					$sql = "INSERT INTO {pwcs_manufacturer}".
				    	   " (pwc_mfg_id, mfg_name, is_sync, created_on, modified_on)".
				    	   " VALUES ( %d, '%s', %d, %d, %d)";
			        db_query(	$sql,
			        			$manufacturer_id,
			        			stripslashes(mysql_escape_string($manufacturer_name)),
			        			1,
			        			$created_on,
			        			$modified_on
			        		);
		    	 }
				if($_POST['status'] == 'updated')
		    	 {

					$sql = "UPDATE {pwcs_manufacturer} ".
				    	   " SET mfg_name='%s', modified_on='%s' ".
				    	   " WHERE pwc_mfg_id='%d' ";
			        db_query(	$sql,
			        			stripslashes(mysql_escape_string($manufacturer_name)),
			        			$modified_on,
			        			$manufacturer_id
			        		);
		    	 }
				if($_POST['status'] == 'deleted')
		    	 {
		    	 	$sql = "DELETE FROM {pwcs_manufacturer} ".
				    	   " WHERE pwc_mfg_id = '%d' LIMIT 1";
			        db_query($sql,$manufacturer_id);

					$sql = "UPDATE {pwcs_product} ".
				    	   " SET manufacturer_id='0' ".
				    	   " WHERE manufacturer_id='%d' ";
			        db_query($sql,$manufacturer_id);
		    	 }
		 	}//if($_POST['status'] == 'created' || $_POST['status'] == 'updated' || $_POST['status'] == 'deleted')

		break;

		case 'attributegroup': // ADD EDIT DELETE any Attribute group, i.e. Color, Size, Type etc.

			if($status == 'created'){
				//    [merchant_row_id] => 2
				//    [group_row_id] => 114
				//    [group_name] => type
				//    [is_required] =>
				//    [status] => created
				//    [merchant_id] => MER-00002
				//    [apikey] => PS4s1S3DF5rw5Fod5s4w8e4xds5d7w5e=
				//    [entity] => attributegroup
				$sql = "INSERT INTO {pwcs_attr_groups} (attr_group_public_name, is_required, pwc_group_row_id, weight ) VALUES ( '%s', %d, %d, %d)";
				db_query($sql, stripslashes(mysql_escape_string($_REQUEST['group_name'])), $_REQUEST['is_required'], $_REQUEST['group_row_id'], '');
			}
			else if($status == 'deleted'){
				//    [group_row_id] => 114
				//    [status] => deleted
				//    [merchant_id] => MER-00002
				//    [apikey] => PS4s1S3DF5rw5Fod5s4w8e4xds5d7w5e=
				//    [entity] => attributegroup

				// Get primary key of this Attribute group
				$groupid = db_result(db_query("SELECT id FROM {pwcs_attr_groups} WHERE pwc_group_row_id = %d", $_REQUEST['group_row_id']));

				// Get All pwc_attribute_id of this Attribute group
				$pwc_attribute_id_all = array();
				$results = db_query("SELECT * FROM {pwcs_attributes} WHERE group_id = %d", $groupid);
				while($result = db_fetch_object($results)) {
					$pwc_attribute_id_all[] = $result->pwc_attribute_id;
				}

				// Delete Product-Attributes relation of this group
				foreach ($pwc_attribute_id_all as $k=>$pwc_attribute_id) {
					db_query("DELETE FROM {pwcs_product_attributes} WHERE attr_id LIKE '%,".$pwc_attribute_id.",%' OR attr_id LIKE '".$pwc_attribute_id.",%' OR attr_id LIKE '%,".$pwc_attribute_id."'");
				}

				// Delete Attributes of this group
				db_query("DELETE FROM {pwcs_attributes} WHERE group_id = %d", $groupid);

				// Delete Attribute group
				db_query("DELETE FROM {pwcs_attr_groups} WHERE pwc_group_row_id = %d", $_REQUEST['group_row_id']);

			}
			else if($status == 'updated'){
				//    [merchant_row_id] => 2
				//    [group_row_id] => 1
				//    [group_name] => Colors
				//    [is_required] =>
				//    [status] => updated
				//    [merchant_id] => MER-00002
				//    [apikey] => PS4s1S3DF5rw5Fod5s4w8e4xds5d7w5e=
				//    [entity] => attributegroup
				$sql = "UPDATE {pwcs_attr_groups} SET attr_group_public_name = '%s', is_required = %d WHERE pwc_group_row_id = %d ";
				db_query($sql, stripslashes(mysql_escape_string($_REQUEST['group_name'])), $_REQUEST['is_required'], $_REQUEST['group_row_id']);
			}
			else {
				// Invalid Status
			}

		break;

		case 'attribute':  // ADD EDIT DELETE any Attribute, i.e. Red, Green, XL, L, Male, Female etc.

			if($status == 'created'){
				//    [group_row_id] => 1
				//    [attribute_row_id] => 626
				//    [attribute_name] => Black
				//    [weight] => 5
				//    [status] => created
				//    [apikey] => PS4s1S3DF5rw5Fod5s4w8e4xds5d7w5e=
				//    [entity] => attribute

				$sql = "INSERT INTO {pwcs_attributes} (pwc_attribute_id, group_id, attr_name, weight) VALUES ( %d, %d, '%s', %d)";
				db_query($sql, $_REQUEST['attribute_row_id'], pwcs_get_store_attr_group_id($_REQUEST["group_row_id"]), stripslashes(mysql_escape_string($_REQUEST['attribute_name'])),$_REQUEST['weight']);
			}
			if($status == 'deleted'){
				//    [attribute_row_id] => 626
				//    [status] => deleted
				//    [apikey] => PS4s1S3DF5rw5Fod5s4w8e4xds5d7w5e=
				//    [entity] => attribute

				// Delete Product-Attributes relation of this group
				db_query("DELETE FROM {pwcs_product_attributes} WHERE attr_id LIKE '%,".$_REQUEST['attribute_row_id'].",%' OR attr_id LIKE '".$_REQUEST['attribute_row_id'].",%' OR attr_id LIKE '%,".$_REQUEST['attribute_row_id']."'");

				// Delete Attributes of this group
				db_query("DELETE FROM {pwcs_attributes} WHERE pwc_attribute_id = %d", $_REQUEST['attribute_row_id']);
			}
			else if($status == 'updated'){
				//    [group_row_id] => 1
				//    [attribute_row_id] => 4
				//    [attribute_name] => Green
				//    [weight] => 0
				//    [status] => updated
				//    [apikey] => PS4s1S3DF5rw5Fod5s4w8e4xds5d7w5e=
				//    [entity] => attribute
				$sql = "UPDATE {pwcs_attributes} SET attr_name = '%s', weight = %d WHERE pwc_attribute_id = %d ";
				db_query($sql, $_REQUEST['attribute_name'], $_REQUEST['weight'], $_REQUEST['attribute_row_id']);
			}
			else if($status == 'assigned'){

				//    [product_row_id] => 5060
				//    [price_change] => -5
				//    [quantity] => 7
				//    [sub_sku] => BM-2011
				//    [attribute_row_id] => 617,627
				//    [is_default] => 1
				//    [status] => assigned
				//    [apikey] => PS4s1S3DF5rw5Fod5s4w8e4xds5d7w5e=
				//    [entity] => attribute

				//pwcs_debug_file_write($_REQUEST, true);

				$attributerowid = $_REQUEST['attribute_row_id'];
				$attributerowid_tmp = explode(",",$attributerowid);
				sort($attributerowid_tmp);
				$attributerowid = implode(",",$attributerowid_tmp);
    		$sql = " INSERT INTO {pwcs_product_attributes} (nid, attr_id, quantity, affected_price, subsku ) VALUES ( %d, '%s', %d, %f, '%s')";
			  db_query($sql, pwcs_get_product_nid($_REQUEST['product_row_id']),$attributerowid, $_REQUEST['quantity'],$_REQUEST['price_change'],$_REQUEST['sub_sku']);
			  if($_REQUEST['is_default'] == 1){
					db_query("UPDATE {pwcs_product}	SET `default_attribute`='%s' WHERE nid = %d", $attributerowid, pwcs_get_product_nid($_REQUEST['product_row_id']));
			  }
			}
			else if($status == 'unassigned'){
				//    [status] => unassigned
				//    [attribute_row_id] => 617,627
				//    [product_row_id] => 5060
				//    [apikey] => PS4s1S3DF5rw5Fod5s4w8e4xds5d7w5e=
				//    [entity] => attribute
				$attributerowid = $_REQUEST['attribute_row_id'];
				$attributerowid_tmp = explode(",",$attributerowid);
				sort($attributerowid_tmp);
				$attributerowid = implode(",",$attributerowid_tmp);
				db_query("DELETE FROM {pwcs_product_attributes} WHERE nid = %d AND attr_id = '%s'", pwcs_get_product_nid($_REQUEST['product_row_id']), $_REQUEST['attribute_row_id']);
				db_query("UPDATE {pwcs_product}	SET `default_attribute`='%s' WHERE `default_attribute` = '%s' AND nid = %d", $attributerowid, $attributerowid, pwcs_get_product_nid($_REQUEST['product_row_id']));
			}
			else {
					// Invalid status
			}
		break;

		case 'sync':     //If notification comes for Quick Sync

				/*
				$merchant_id = $_POST['merchantid'];


				pwcs_debug_file_write($_POST, true);
				die();

			    if($_POST['status'] == 'update')
			    {
			    // Will get merchant email address, merchant web address, company name, merchant full name, email the merchant,
			    // Will get merchant last name & then convert it to small letter,
			    // Will create my web site list also
			    // Will collect the merchnat API key & if not then will create in PWC
			    // Will save the domain name at pWC for cart api auto
			    // Will sync for the merchant

				$response = pwcs_getMerchantInformation();
			    pwcs_debug_file_write('Response Data:'.$response);

				if (module_exists('xml_parser')){
					$response = xml_clean($response);
					$response_array = xml_parser_string_to_array($response);
				} else
					$response_array = 'module not enabled';

				pwcs_debug_file_write($response_array, true);

				//echo $response_array['merchantfirstname'];
				variable_set('file_directory_path', 'sites/default2/files');
				variable_set('site_name', 'My Store Site');
				variable_set('site_mail', 'a.r.zerin@gmail.com');
				variable_set('site_footer', 'copyright @ '.date('Y').', Premium Web Cart Inc.');


				$updateemail = db_query("UPDATE {users} SET name='".strtolower($response_array['merchantlastname'])."', mail='a.r.zerin@gmail.com',init='a.r.zerin@gmail.com',merchant_enc_id='',site_api_key='' WHERE uid = '2'");


			    }
				*/
		default:
			// Invalid API Request
		break;
  }
	return null;
}

/**
 * The Purpose of this function to redirect the Admin or User to the Login Page
 * This is just a user friendly task, it is easy to memorize the login word
 */
function user_login_page() {
	global $user;
	$tmp = NULL;
	session_destroy();
	user_module_invoke('logout', $tmp, $user);
	$user = drupal_anonymous_user();	
	drupal_goto('user');
}


function pwcs_admin_sync_settings($done = NULL) {

	if($done != 'done') {

		drupal_set_message(t('Synchronization may take couple of minutes.'), 'warning');


		drupal_set_message(t('Synchronization will delete all Products Images that you have uploaded from Store Site. You should use this Synchronization only if you see that, Products in PWC Store is not upto date with Products in Premium Web Cart, otherwise You should not use Synchronization feature.'), 'error');
		drupal_set_message(t('Synchronization will restore all the Products again from your Premium Web Cart Merchant Account to your PWC Store.'), 'warning');
		/*drupal_set_message(t('Synchronization will delete all the categories & products (including Product Option Group & Options) from your Store Site.<br/>We will be not able to recover them again for you anyhow.'), 'warning');
		*/
	}
	$output = '';
	$output .= drupal_get_form('pwcs_admin_sync_form');
	return $output;
}


function pwcs_admin_sync_form() {

	global $user;

	$merchantidlink = l(t('(Home >> Account Settings >> Current Status)'), PWCS_PWC_AUTO_LOGIN_URL . PWCS_PWC_CORE_URL . 'advanceIntegration.html' , array('attributes' => array('class'=>'pwcs-popup-iframe', 'title'=>'PREMIUMWEBCART Advance Integration')));
	$merchantapisignlink = l(t('(Home >> Cart Settings >> Advanced Integration (API Integration Tab))'), PWCS_PWC_AUTO_LOGIN_URL . PWCS_PWC_CORE_URL . 'advanceIntegration.html' , array('attributes' => array('class'=>'pwcs-popup-iframe', 'title'=>'PREMIUMWEBCART Advance Integration')));

	$form['pwcs_merchant_id'] = array(
		'#type' => 'textfield',
		'#title' => t('Premium Web Cart Merchant Id'),
		'#description' => t('You will get it in your PREMIUMWEBCART Merchant Panel ').$merchantidlink,
		'#default_value' => $user->merchant_enc_id,
	);

	$form['pwcs_merchant_api'] = array(
		'#type' => 'textfield',
		'#title' => t('Premium Web Cart Merchant API Signature'),
		'#description' => t('You will get it in your PREMIUMWEBCART Merchant Panel ').$merchantapisignlink ,
		'#default_value' => $user->site_api_key,
	);

	if (variable_get('pwcs_load_category_data', '1')==1)
		$sync_done_message = ' [<b>Not Completed</b>]';
	else
		$sync_done_message = '';

	$form['pwcs_merchant_api_sync_category'] = array(
		'#type' => 'checkbox',
		'#title' => t('Sync Category').'',
		'#description' => t('You will be able to place Product under one category'),
		'#default_value' => variable_get('pwcs_load_category_data', '1'),
	);
	$form['pwcs_merchant_api_sync_list'] = array(
		'#type' => 'checkbox',
		'#title' => t('Sync Listing').'',
		'#description' => t('Listing will give you the opportunity to place a product under multiple Listing'),
		'#default_value' => variable_get('pwcs_load_category_data', '1'),
	);
	
	
	if (variable_get('pwcs_load_product_data', '1')==1)
		$sync_done_message = ' [<b>Not Completed</b>]';
	else
		$sync_done_message = '';
		
	if (variable_get('pwcs_load_updated_product_data', '1')==1)
		$sync_done_message2 = ' [<b>Not Completed</b>]';
	else
		$sync_done_message2 = '';
		
	$form['pwcs_merchant_api_sync_product'] = array(
		'#type' => 'radios',
		'#options' => array('1'=>t('Newly - Select this if you are synching first time. Will delete all the Products & uploaded Image').$sync_done_message, '2'=>t('Update Only - Do not delete Current Products & assigned Images for those Products, Just Update Products').$sync_done_message,),
		'#default_value' => variable_get('pwcs_load_updated_product_data', '1'),
		'#title' => t('Sync Products'),
	);



	if (variable_get('pwcs_load_manufacturer_data', '1')==1)
		$sync_done_message = ' [<b>Not Completed</b>]';
	else
		$sync_done_message = '';

	$form['pwcs_merchant_api_sync_manufacturer'] = array(
		'#type' => 'checkbox',
		'#title' => t('Sync Manufacturer').$sync_done_message,
		//'#description' => t('For Every Single Product View your End User will see Manufacturer Details under Manufacturer Tab'),
		'#default_value' => variable_get('pwcs_load_manufacturer_data', '1'),
	);

	if (variable_get('pwcs_load_basic_settings_data', '1')==1)
		$sync_done_message = ' [<b>Not Completed</b>]';
	else
		$sync_done_message = '';

	$form['pwcs_merchant_api_sync_basic_settings'] = array(
		'#type' => 'checkbox',
		'#title' => t('Sync Basic Settings '),
		'#description' => t('Product Prefix, Currency Symbol, Currency will be pulled from Your Merchant Account'),
		'#default_value' => variable_get('pwcs_load_basic_settings_data', '1'),
	);

	if (variable_get('pwcs_load_attribute_data', '1')==1)
		$sync_done_message = ' [<b>Not Completed</b>]';
	else
		$sync_done_message = '';

	$form['pwcs_merchant_api_sync_attributes'] = array(
		'#type' => 'checkbox',
		'#title' => t('Sync Attributes/Options Information '),
		//'#description' => t('For Every Single Product View your End User will see Manufacturer Details under Manufacturer Tab'),
		'#default_value' => variable_get('pwcs_load_attribute_data', '1'),
	);

	$form['button'] = array(
		'#type' => 'submit',
		'#default_value' => 'Save and Sync Now'
	);

	return $form;
}

function pwcs_admin_sync_form_submit($form, $form_value)
{
	global $user;


	variable_set('pwcs_load_category_data', $form_value['values']['pwcs_merchant_api_sync_category']);
	variable_set('pwcs_load_listing_data', $form_value['values']['pwcs_merchant_api_sync_list']);
	
	if ($form_value['values']['pwcs_merchant_api_sync_product']==1)
	variable_set('pwcs_load_product_data', 1);
	if ($form_value['values']['pwcs_merchant_api_sync_product']==2)
	variable_set('pwcs_load_updated_product_data', 1);
	
	variable_set('pwcs_load_attribute_data', $form_value['values']['pwcs_merchant_api_sync_attributes']);
	variable_set('pwcs_load_manufacturer_data', $form_value['values']['pwcs_merchant_api_sync_manufacturer']);
	variable_set('pwcs_load_basic_settings_data', $form_value['values']['pwcs_merchant_api_sync_basic_settings']);


    if($form_value['submitted'] == 1) {
			variable_set('pwcs_fetchMerchantData', '0');
			db_query("UPDATE {users} SET `merchant_enc_id`='%s', `site_api_key`='%s' WHERE uid = %d", $form_value['values']['pwcs_merchant_id'], $form_value['values']['pwcs_merchant_api'], $user->uid);
			pwcs_fetchMerchantData($form_value['values']['pwcs_merchant_id'], $form_value['values']['pwcs_merchant_api']);
			variable_set('pwcs_fetchMerchantData', '1');
			drupal_set_message(t('Data Sync Completed!'));
	    $_REQUEST[destination] = 'siteadmin/sync-settings/done';
    }

}

/**
 * Menu callback; generic function to display a page of the most frequent search keywords
 * Added by Rasel Kabir
 */
function pwcs_topreports($type = 'search') {

  $header = array(
    array('data' => t('Count'), 'field' => 'count', 'sort' => 'desc'),
    array('data' => t('Message'))
  );

  $result = pager_query("SELECT COUNT(wid) AS count, message, variables FROM {watchdog} WHERE type = '%s' GROUP BY message, variables ". tablesort_sql($header), 30, 0, "SELECT COUNT(DISTINCT(message)) FROM {watchdog} WHERE type = '%s'", $type);

  $rows = array();
  while ($dblog = db_fetch_object($result)) {
    //$rows[] = array($dblog->count, truncate_utf8(_dblog_format_message($dblog), 56, TRUE, TRUE));
	//print_r ($dblog);
	//print_r(unserialize($dblog->variables));
	$dblog->message = str_replace(' (@type).','',$dblog->message);
	$message = t($dblog->message, unserialize($dblog->variables));
    $rows[] = array($dblog->count, $message);
  }

  if (empty($rows)) {
    $rows[] = array(array('data' => t('No Search Word has been used for searching.'), 'colspan' => 2));
  }

  $output  = theme('table', $header, $rows);
  $output .= theme('pager', NULL, 30, 0);

  return $output;
}

function pwcs_topreports_clear($type = 'search') {
  db_query("DELETE FROM {watchdog} WHERE type = '%s'", $type);
  drupal_goto('siteadmin/reports/search');

}

