		'#title' => t('Developer Debug ON/OFF'),
		'#description' => t('Check to enable debug file write.').' '.l('Click Here To Clean Debug File', 'admin/settings/pwcs/debug_file_clean').'. And '.l('Click Here To View Debug File', PWCS_STORE_URL.'pwcsdebug.txt').'.',
		'#default_value' => variable_get('pwcs_dev_debug', 1),
	);

	return system_settings_form($form);
}

/**
 * Settings page for Siteadmin
 * @return form array for siteadmin settings page
 * Added by Rasel Kabir <shuvro.mist@gmail.com>
 */
function pwcs_siteadmin_sitesettings() {

	// Manufacture block settings
	$form['pwcs_manufacturer_block'] = array('#type' => 'fieldset', '#title' => t('Manufacturer Block Settings'));
	$form['pwcs_manufacturer_block']['#prefix'] = '<div id="pwcs_manufacturer_block">';
	$form['pwcs_manufacturer_block']['#suffix'] = '</div>';
	$form['pwcs_manufacturer_block']['#collapsible'] = 1;
	$form['pwcs_manufacturer_block']['#collapsed'] = 1;
	$form['pwcs_manufacturer_block']['pwcs_manufacturer_block_type'] = array(
		'#type' => 'radios',
		'#options' => array(0=>t('Random Manufacturer'), 1=>t('Featured Manufacturer')),
		'#title' => t('Manufacturer block items will be'),
		'#description' => t('Selected way will be shown in Manufacturer block.').' '.l('Go to this link to EDIT "Featured Manufacturer".', 'siteadmin/manufacturers'),
		'#default_value' => variable_get('pwcs_manufacturer_block_type', '0'),
	);
	$form['pwcs_manufacturer_block']['pwcs_manufacturer_block_item_amount'] = array(
		'#type' => 'textfield',
		'#title' => t('Maximum Manufacturer No in Manufacture Block (If random selected)'),
		'#description' => t('No. of Manufacturer which will be set in Manufacturer Block if the block is enabled.'),
