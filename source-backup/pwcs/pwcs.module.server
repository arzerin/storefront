	// Product Review settings
	$form['pwcs_productreview_settings'] = array('#type' => 'fieldset', '#title' => t('Product Review Settings'));
	$form['pwcs_productreview_settings']['#prefix'] = '<div id="pwcs_productreview_settings">';
	$form['pwcs_productreview_settings']['#suffix'] = '</div>';
