function pwcs_update_22()
{
$ret = array();
	db_query("ALTER TABLE  {pwcs_listings} CHANGE  `pwc_category_id`  `pwc_category_id` INT( 10 ) NOT NULL DEFAULT  '-1'");	
	db_query("ALTER TABLE  {pwcs_product_listing} CHANGE  `listing_id`  `listing_id` INT( 10 ) NOT NULL DEFAULT  '-1'");
	db_query("UPDATE  {pwcs_product_listing} SET  `listing_id` =-1 WHERE `listing_id` =0");	
	db_query("UPDATE  {pwcs_listings} SET  `pwc_category_id` =-1 WHERE `pwc_category_id` =0");	
return $ret;	
}
