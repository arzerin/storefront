/**
 * @file
 * pwcs installation.
 * Added by Rasel Kabir
 */

/**
 * Implementation of hook_install().
 * Added by Rasel Kabir
 */
function pwcs_install() {
  if (drupal_install_schema('pwcs') && pwcs_user_alter('install')) {
      drupal_set_message(t('pwcs was successfully installed.'));
  }
  else {
    drupal_set_message(t('The installation of pwcs was not successful.'), 'error');
  }

//	// Creating Site amdin custom menu
//	$menu['menu_name'] = 'pwcs-siteadmin';
//	$menu['title']= 'Site Admin';
//	$menu['description']= 'Site admin menu for PWC Store module (pwcs). It will be available only for Siteadmin';
//	db_query("INSERT INTO {menu_custom} (menu_name, title, description) VALUES ('%s', '%s', '%s')", $menu['menu_name'], $menu['title'], $menu['description']);

	variable_set('pwcs_pwcbasicsettings_currency', 'USD');
	variable_set('pwcs_pwcbasicsettings_currency_symbol', '$');
	variable_set('pwcs_pwcbasicsettings_product_id_prefix', 'PRO'); // sample product ID = PRO-00001 (5 digit padding)
}

/**
 * Implementation of hook_uninstall().
 * Added by Rasel Kabir
 */
function pwcs_uninstall() {
  drupal_uninstall_schema('pwcs');
  pwcs_user_alter('uninstall');
  db_query("DELETE FROM {variable} WHERE name LIKE 'pwcs_%%'");
}

/**
 * Implementation of hook_schema().
 * Added by Rasel Kabir
 */
function pwcs_schema() {

  $schema['pwcs_category'] = array(
    'description' => 'Category Table.',
    'fields' => array(
			'category_id' => array( 'type' => 'serial', 'unsigned' => TRUE,	'not null' => TRUE ),
			'pwc_category_id' => array( 'type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0 ),
			'parent_category_id' => array( 'type' => 'int', 'unsigned' => TRUE,	'not null' => TRUE, 'default' => 0 ),
			'category_title' => array( 'type' => 'varchar', 'length' => 150, 'default' => NULL),
			'category_level' => array( 'type' => 'int', 'length' => 5, 'unsigned' => TRUE,	'not null' => TRUE, 'default' => 0 ),
			'has_child' => array( 'type' => 'int', 'length' => 1, 'unsigned' => TRUE,	'not null' => TRUE, 'default' => 0 ),
			'is_editable' => array( 'type' => 'int', 'length' => 1, 'unsigned' => TRUE,	'not null' => TRUE, 'default' => 0 ),
			'is_sync' => array( 'type' => 'int', 'length' => 1, 'unsigned' => TRUE,	'not null' => TRUE, 'default' => 0 ),
  			//`created_on` datetime NOT NULL,
			'created_on' => array( 'type' => 'int', 'not null' => TRUE, 'default' => 0 ),
  			//`modified_on` datetime NOT NULL,
			'modified_on' => array( 'type' => 'int', 'not null' => TRUE, 'default' => 0 ),
			//'description' => array( 'type' => 'text'),
    ),
    'primary key' => array('category_id'),
  );


  $schema['pwcs_product'] = array(
    'description' => 'Product Table.',
    'fields' => array(
		  	//`product_id` int(11) NOT NULL auto_increment,
		  	'nid' => array( 'type' => 'int', 'unsigned' => TRUE,	'not null' => TRUE, 'default' => 0 ),
			'pwc_product_row_id' => array( 'type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0 ),
			'product_link_id' => array( 'type' => 'varchar',  'length' => 200, 'not null' => TRUE, 'default' => NULL ),
			'product_sku' => array( 'type' => 'varchar', 'length' => 50, 'not null' => TRUE, 'default' => NULL),
			'product_name' => array( 'type' => 'varchar', 'length' => 150, 'not null' => TRUE, 'default' => NULL),
			'pwc_category_id' => array( 'type' => 'int', 'unsigned' => TRUE,	'not null' => TRUE, 'default' => 0 ),
			'price' => array( 'type' => 'float', 'not null' => TRUE, 'default' => 0 ),
			'regular_buy_link' => array( 'type' => 'varchar', 'length' => 150 ),
			'one_click_buy_link' => array( 'type' => 'varchar', 'length' => 150 ),
			'product_image_path' => array( 'type' => 'varchar', 'length' => 150 ),
			'is_sync' => array( 'type' => 'int', 'length' => 1, 'unsigned' => TRUE,	'not null' => TRUE, 'default' => 0 ),
			'created_on' => array( 'type' => 'int', 'not null' => TRUE, 'default' => 0 ),
			'modified_on' => array( 'type' => 'int', 'not null' => TRUE, 'default' => 0 ),
			//'description' => array( 'type' => 'text'),
    ),
    'primary key' => array('nid'),
  );


  $schema['pwcs_product_category'] = array(
    'description' => 'Product Category Relation Table.',
    'fields' => array(
			'product_cateogry_id' => array( 'type' => 'serial', 'unsigned' => TRUE,	'not null' => TRUE ),
			'category_id' => array( 'type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0 ),
			'product_nid' => array( 'type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0 ),
    ),
    'primary key' => array('product_cateogry_id'),
  );

//  $schema['pwcs_settings'] = array(
//    'description' => 'Product Category Relation Table.',
//    'fields' => array(
//			'settings_id' => array( 'type' => 'serial', 'unsigned' => TRUE,	'not null' => TRUE ),
//			'merchant_enc_id' => array( 'type' => 'varchar', 'length' => 50 ),
//			'site_api_key' => array( 'type' => 'varchar', 'length' => 50 ),
//    ),
//    'primary key' => array('settings_id'),
//  );

  $schema['pwcs_temp_order'] = array(
    'description' => 'Product Category Relation Table.',
    'fields' => array(
			'temp_order_id' => array( 'type' => 'serial', 'unsigned' => TRUE,	'not null' => TRUE ),
			'temp_order_session' => array( 'type' => 'varchar', 'length' => 255 ),
			'pwc_order_temp_id' => array( 'type' => 'int', 'unsigned' => TRUE,	'not null' => TRUE, 'default' => 0 ),
			'pwc_order_token' => array( 'type' => 'varchar', 'length' => 200 ),
			'product_nid' => array( 'type' => 'int', 'unsigned' => TRUE,	'not null' => TRUE, 'default' => 0 ),
			'amount' => array( 'type' => 'int', 'unsigned' => TRUE,	'not null' => TRUE, 'default' => 1 ),
    ),
    'primary key' => array('order_temp_id'),
  );

  return $schema;
}

/**
 * user table alter SQL
 * Added by Rasel Kabir
 */
function pwcs_user_alter($condition = 'install') {

	if($condition == 'install')
	{
		$ret = array();
		db_add_field($ret, 'users', 'merchant_enc_id', array( 'type' => 'varchar', 'length' => 150, 'default' => NULL) );
		db_add_field($ret, 'users', 'site_api_key', array( 'type' => 'varchar', 'length' => 150, 'default' => NULL) );
		return $ret;
	}
	else if($condition == 'uninstall')
	{
		$ret = array();
		db_drop_field($ret, 'users', 'merchant_enc_id');
		db_drop_field($ret, 'users', 'site_api_key');
		return $ret;
	}
}

/**
 * hook_update_1
 * Added by Rasel Kabir on Sept 2010
 */
function pwcs_update_1()
{
	$ret = array();
 	db_query("ALTER TABLE  {pwcs_category} ADD  `weight` TINYINT( 4 ) NOT NULL DEFAULT  '0' AFTER  `is_sync`");
 	db_query("ALTER TABLE  {pwcs_category} ADD  `status` TINYINT( 4 ) NOT NULL DEFAULT  '1' AFTER  `weight`");
	return $ret;
}

