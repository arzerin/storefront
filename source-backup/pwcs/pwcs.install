/**
 * Activate Comments for all products
 * Added by Rasel Kabir
 */
function pwcs_update_28()
{
	$ret = array();

	// COMMENT SETTINGS
	variable_set('comment_product', 2);
	variable_set('comment_default_mode_product', 4);
	variable_set('comment_default_order_product', 1);
	variable_set('comment_default_per_page_product', 50);
	variable_set('comment_controls_product', 0);
	variable_set('comment_anonymous_product', 1);
	variable_set('comment_subject_field_product', 1);
	variable_set('comment_preview_product', 0);
	variable_set('comment_form_location_product', 1);

	// FIVESTAR SETTINGS
	$fivestar_labels_product = array( 'No Rating', 'Poor', 'Okay', 'Good', 'Great', 'Awesome', 'Give it @star/@count', 'Give it @star/@count', 'Give it @star/@count', 'Give it @star/@count', 'Give it @star/@count' );
	variable_set('fivestar_labels_product', $fivestar_labels_product);
	variable_set('fivestar_widget', 'sites/all/modules/fivestar/widgets/flames/flames.css');
	variable_set('fivestar_labels_enable_product', 1);
	variable_set('fivestar_stars_product', 5);
	variable_set('fivestar_color_type', 'solid');
	variable_set('fivestar_product', 1);
	variable_set('fivestar_style_product', 'dual');
	variable_set('fivestar_text_product', 'dual');
	variable_set('fivestar_title_product', 1);
	variable_set('fivestar_feedback_product', 1);
	variable_set('fivestar_unvote_product', 0);
	variable_set('fivestar_position_teaser_product', 'above');
	variable_set('fivestar_position_product', 'above');
	variable_set('fivestar_comment_product', 1);
    $fivestar_colors = array( 'on1' => '#fff633', 'on2' => '#f5d000', 'hover1' => '#d2e7f9', 'hover2' => '#027ac6', 'off1' => '#cccccc', 'off2' => '#dfdfdf', 'matte' => '#ffffff' );
	variable_set('fivestar_colors', $fivestar_colors);

	variable_set('node_rank_comments', 5);

	// Voting API Set
	variable_set('votingapi_anonymous_window', 86400);
	variable_set('votingapi_calculation_schedule', 'immediate');

	//Enable Comments for All Products
	db_query("UPDATE {node} SET `comment` = 2 WHERE `type`='product'");	

	//Set comment permissions for End User (anonymous user = 1 and authenticated user = 2)
	$perms = array('access comments', 'post comments');
	pwcs_addpermission($perms, 'anonymous user');
	$perms = array('access comments', 'post comments', 'post comments without approval');
	pwcs_addpermission($perms, 'authenticated user');
	variable_set('pwcs_sitesettings_productreview_approvecomments', '1');

	//Set comment permissions for Siteadmin (siteadmin = 3 and superadmin = 4)
	$perms = array('access comments', 'administer comments', 'post comments', 'post comments without approval');
	pwcs_addpermission($perms, 'siteadmin');
	pwcs_addpermission($perms, 'superadmin');
	//pwcs_removepermission($perms , 'anonymous user');

	//Set Five star Permissions
    pwcs_addpermission('rate content', 'anonymous user');
    pwcs_addpermission('rate content', 'authenticated user');
    pwcs_addpermission('rate content', 'siteadmin');
    pwcs_addpermission('rate content', 'superadmin');

	//Set Voting API Permissions
    pwcs_addpermission('administer voting api', 'siteadmin');
    pwcs_addpermission('administer voting api', 'superadmin');

	return $ret;	
}

/* Added for Sales Price */
function pwcs_update_29()
{	
	$ret = array();
	$schema['pwcs_product_sales'] = array(
		'description' => 'Product Sales Price.',
		'fields' => array(
			'nid' 					=> array('type'=>'int', 'unsigned'=>TRUE, 'not null'=>TRUE, 'default'=>0),
			'pwc_product_row_id'	=> array('type'=>'int', 'unsigned'=>TRUE, 'not null'=>TRUE, 'default'=>0),
			'product_sale_price'	=> array('type'=>'float', 'precision'=>10, 'scale'=>2),
			'enable_sales_price'	=> array('type'=>'int', 'size'=>'tiny', 'unsigned'=>TRUE, 'default'=>0),
			'sale_price_start_date'	=> array('type'=>'int', 'unsigned'=>TRUE, 'default'=>0),
			'sale_price_end_date' 	=> array('type'=>'int', 'unsigned'=>TRUE, 'default'=>0),
			'sale_tag_icon' 		=> array('type'=>'int', 'size'=>'tiny', 'unsigned'=>TRUE, 'default'=>1),
		),
		'primary key' => array('nid'),
	);
	db_create_table($ret, 'pwcs_product_sales', $schema['pwcs_product_sales']);
	return $ret;
}
