function pwcs_attribute_group_count() {
	$countrows = db_result(db_query("SELECT COUNT(*) FROM {pwcs_attr_groups}"));
	return ($countrows > 0) ? $countrows : 0;
}
function pwcs_manufacturer_count() {
	$countrows = db_result(db_query("SELECT COUNT(*) FROM {pwcs_manufacturer}"));
	return ($countrows > 0) ? $countrows : 0;
}







/**** Sitemap and Search Engine Functions ****/

function pwcs_get_sitemap_file_name($myFile = "sitemap.xml") {

    $myFile = $_SERVER['HTTP_HOST'].'-'.$myFile;
    return $myFile;
}
function pwcs_sitemap_file_write($stringData='', $myFile = "sitemap.xml") {

	if(variable_get('pwcs_sitemap_enabled', 1) == 0) {
		return;
	}

    $myFile = pwcs_get_sitemap_file_name();
	$stringData=pwcs_get_sitemap_xml();

	$fh = @fopen($myFile, 'w+') or drupal_set_message(t('Could Not Create Sitemap file : '.$myFile), 'error');;
	@fwrite($fh, $stringData);
	@fclose($fh);
}
function pwcs_get_sitemap_xml(){

	global $base_url;
	$b = '';
	$sql  = "SELECT n.nid FROM {node} n WHERE (n.type = 'product' OR n.type = 'page' OR n.type = 'sitepage') AND n.status='1' ORDER BY n.type ASC";
	$results = db_query($sql);
	while($result = db_fetch_object($results))
	{
			$thisnode = node_load($result->nid);
			//$b .= $base_url.'/'.$thisnode->path.CHR(13).CHR(10);
			//$b .= format_date($thisnode->changed, 'custom', 'Y-m-d', 0).CHR(13).CHR(10);
			$b .= '	<url>
					<loc>'.htmlentities($base_url.'/'.$thisnode->path).'</loc>
					<lastmod>'.format_date($thisnode->changed, 'custom', 'Y-m-d', 0).'</lastmod>
					<changefreq>weekly</changefreq>
					<priority>0.8</priority>
				  </url>'.CHR(13).CHR(10);
	}

	$sitemap_text='<?xml version="1.0" encoding="utf-8"?>
			<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
			'.$b.'
			</urlset>';


	return trim($sitemap_text);
}
function pwcs_get_store_sitemap_location()
{
	global $base_url;
	$sitemap_location = $base_url.'/'.pwcs_get_sitemap_file_name();
	return $sitemap_location;
}
function pwcs_pingto_search_engine()
{
	global $base_url;
	$sitemap_location = $base_url.'/'.pwcs_get_sitemap_file_name();


	$target_url1 =  variable_get('pwcs_yahoo_ping_url', 'http://search.yahooapis.com/SiteExplorerService/V1/updateNotification?appid=SitemapWriter&url=#SITEMAP_URL');
	$target_url1 = str_replace('#SITEMAP_URL',$sitemap_location,$target_url1);

	if(variable_get('pwcs_my_sitemap_yahoo_enabled', 0) == 1) {
		pwcs_ping_search_engine('Yahoo',$target_url1);
	}

	$target_url1 =  variable_get('pwcs_ask_ping_url', 'http://submissions.ask.com/ping?sitemap=#SITEMAP_URL');
	$target_url1 = str_replace('#SITEMAP_URL',$sitemap_location,$target_url1);
	if(variable_get('pwcs_my_sitemap_ask_enabled', 0) == 1) {
		pwcs_ping_search_engine('ASK.com',$target_url1);
	}

	$target_url1 =  variable_get('pwcs_bing_ping_url', 'http://www.bing.com/webmaster/ping.aspx?siteMap=#SITEMAP_URL');
	$target_url1 = str_replace('#SITEMAP_URL',$sitemap_location,$target_url1);
	if(variable_get('pwcs_my_sitemap_bing_enabled', 0) == 1) {
		pwcs_ping_search_engine('Bing',$target_url1);
	}

	$target_url1 =  variable_get('pwcs_google_ping_url', 'http://www.google.com/webmasters/tools/ping?sitemap=#SITEMAP_URL');
	$target_url1 = str_replace('#SITEMAP_URL',$sitemap_location,$target_url1);
	if(variable_get('pwcs_my_sitemap_google_enabled', 0) == 1) {
		pwcs_ping_search_engine('Google',$target_url1);
	}


}
/**
 * Cache Clear in full
 * Added By Rasel Kabir
 */
function pwcs_flush_cache(){
  _drupal_flush_css_js();
  drupal_clear_css_cache();
  drupal_clear_js_cache();

  $core = array('cache', 'cache_block', 'cache_filter', 'cache_page');
  $cache_tables = array_merge(module_invoke_all('flush_caches'), $core);
  foreach ($cache_tables as $table) {
    cache_clear_all('*', $table, TRUE);
  }
  unset($_SESSION['messages']);
}

