		//'#style'=> 'width: 250px;'
	);
	$form['variable_settings']['target_urls']['pwcs_target_url_basicSettings'] = array(
		'#type' => 'textfield',
		'#title' => t('Merchant Basic Settings Information API URL'),
		'#description' => t('Ex. currency, currencysymbol, productidprefix'),
		'#default_value' => variable_get('pwcs_target_url_basicSettings', 'testapi/basicSettings.html') ,
		'#maxlength' => 180,
		//'#style'=> 'width: 250px;'
	);
	$form['variable_settings']['target_urls']['pwcs_target_url_categoryorderupdate'] = array(
		'#type' => 'textfield',
		'#title' => t('Category Order Update URL'),
		'#description' => t('This will help to change the Category Order at a time'),
		'#default_value' => variable_get('pwcs_target_url_categoryorderupdate', 'api/saveCategoryOrder.html') ,
		'#maxlength' => 180,
		//'#style'=> 'width: 250px;'
	);
	$form['variable_settings']['target_urls']['pwcs_target_url_attributesinfo'] = array(
		'#type' => 'textfield',
		'#title' => t(PWCS_ATTRIBUTE_GROUP_NAME.' & '. PWCS_ATTRIBUTE_NAME.' API URL'),
		'#description' => t('This will pull '.PWCS_ATTRIBUTE_GROUP_NAME.' & '. PWCS_ATTRIBUTE_NAME.' information from PremiumWebCart for the Merchant respectively'),
		'#default_value' => variable_get('pwcs_target_url_attributesinfo', 'testapi/productOption.html') ,
		'#maxlength' => 180,
		//'#style'=> 'width: 250px;'
	);

	$form['variable_settings']['searchengine_ping_urls'] = array('#type' => 'fieldset', '#title' => t('Search Engine Ping URL'));
	$form['variable_settings']['searchengine_ping_urls']['#collapsed'] = 1;

	$form['variable_settings']['searchengine_ping_urls']['pwcs_google_ping_url'] = array(
		'#type' => 'textfield',
		'#title' => t('Google Ping URL'),
		'#description' => t('This is the URL where our store app will submit sitemap.xml to this search engine whenever it will be updated & if the auto sitemap creation is enabled from your admin panel'),
		'#default_value' => variable_get('pwcs_google_ping_url', 'http://www.google.com/webmasters/tools/ping?sitemap#SITEMAP_URL') ,
		'#maxlength' => 180,
		//'#style'=> 'width: 250px;'
	);

	$form['variable_settings']['searchengine_ping_urls']['pwcs_yahoo_ping_url'] = array(
		'#type' => 'textfield',
		'#title' => t('Yahoo Ping URL'),
		'#description' => t('This is the URL where our store app will submit sitemap.xml to this search engine whenever it will be updated & if the auto sitemap creation is enabled from your admin panel'),
		'#default_value' => variable_get('pwcs_yahoo_ping_url', 'http://search.yahooapis.com/SiteExplorerService/V1/updateNotification?appid=SitemapWriter&url=#SITEMAP_URL') ,
		'#maxlength' => 180,
		//'#style'=> 'width: 250px;'
	);

	$form['variable_settings']['searchengine_ping_urls']['pwcs_ask_ping_url'] = array(
		'#type' => 'textfield',
		'#title' => t('ASK.com Ping URL'),
		'#description' => t('This is the URL where our store app will submit sitemap.xml to this search engine whenever it will be updated & if the auto sitemap creation is enabled from your admin panel'),
		'#default_value' => variable_get('pwcs_ask_ping_url', 'http://submissions.ask.com/ping?sitemap=#SITEMAP_URL') ,
		'#maxlength' => 180,
		//'#style'=> 'width: 250px;'
	);

	$form['variable_settings']['searchengine_ping_urls']['pwcs_bing_ping_url'] = array(
		'#type' => 'textfield',
		'#title' => t('Bing Ping URL'),
		'#description' => t('This is the URL where our store app will submit sitemap.xml to this search engine whenever it will be updated & if the auto sitemap creation is enabled from your admin panel'),
		'#default_value' => variable_get('pwcs_bing_ping_url', 'http://www.bing.com/webmaster/ping.aspx?siteMap=#SITEMAP_URL') ,
		'#maxlength' => 180,
		//'#style'=> 'width: 250px;'
	);

	$form['variable_settings']['enable_disable_features'] = array('#type' => 'fieldset', '#title' => t('Enable Features'));
	$form['variable_settings']['enable_disable_features']['#collapsed'] = 1;
	$form['variable_settings']['enable_disable_features']['pwcs_admin_enable_imageslideshow'] = array(
		'#type' => 'checkbox',
		'#title' => t('Enable Image Slideshow'),
		'#description' => '',
		'#default_value' => variable_get('pwcs_admin_enable_imageslideshow', 0),
	);

	$form['variable_settings']['dev']['pwcs_dev_debug'] = array(
		'#type' => 'checkbox',
		'#title' => t('Developer Debug ON/OFF'),
		'#description' => t('Check to enable debug file write.').' '.l('Click Here To Clean Debug File', 'admin/settings/pwcs/debug_file_clean').'. And '.l('Click Here To View Debug File', PWCS_STORE_URL.'pwcsdebug.txt').'.',
		'#default_value' => variable_get('pwcs_dev_debug', 1),
	);

	return system_settings_form($form);
}

/**
 * Settings page for Siteadmin
 * @return form array for siteadmin settings page
 * Added by Rasel Kabir <shuvro.mist@gmail.com>
 */
function pwcs_siteadmin_sitesettings() {

	//Cart settings
	$form['cart_settings'] = array('#type' => 'fieldset', '#title' => t('Cart /Soft Add To Cart Settings'));
	$form['cart_settings']['#collapsible'] = 1;
	$form['cart_settings']['#collapsed'] = 1;

	$cart_themes = array('1'=>'Row view', '2'=>'Column based with scrolling effect');
	$form['cart_settings']['pwcs_sitesettings_cart_theme'] = array(
		'#type' => 'radios',
		'#options' => $cart_themes,
		'#title' => t('View Style'),
		//'#description' => t('Selected theme will shown in cart info modalbox/popup/page'),
		'#default_value' => variable_get('pwcs_sitesettings_cart_theme', '1') ,
	);

	$form['cart_settings']['pwcs_sitesettings_cart_itemamount'] = array(
		'#type' => 'textfield',
		'#title' => t('No of Product to be displayed in the Soft Add To Cart'),
		//'#description' => t('No. of Product will be shown in the POPUP cart'),
		'#default_value' => variable_get('pwcs_sitesettings_cart_itemamount', '4') ,
		'#maxlength' => 180,
		//'#style'=> 'width: 250px;'
	);

	$form['cart_settings']['pwcs_sitesettings_cart_scrollamount'] = array(
		'#type' => 'textfield',
		'#title' => t('Scroll Product at a time'),
		'#description' => t('No. of items will be scrolled when user will click the left / right navigation bar  from POPUP cart'),
		'#default_value' => variable_get('pwcs_sitesettings_cart_scrollamount', '1') ,
		'#maxlength' => 180,
		//'#style'=> 'width: 250px;'
	);

	$auto_scroll = variable_get('pwcs_sitesettings_cart_autoscroll', '1');
	$form['cart_settings']['pwcs_sitesettings_cart_autoscroll'] = array(
		'#type' => 'checkbox',
		'#title' => t('Auto Scroll'),
		//'#description' => t('Enable auto scroll for cart items'),
		'#default_value' => $auto_scroll,
	);

	$form['cart_settings']['pwcs_cart_link_title'] = array(
		'#type' => 'textfield',
		'#title' => t('Cart Link Title'),
		'#description' => t('This will show in your cart link.<br>Use variable <b>!amount</b> for total product amount in the cart. And <b>!total_quantity</b> for total quantity amount in each product. <br/>Example: <em>Cart: total !total_quantity items for !amount products</em>'),
		'#default_value' => variable_get('pwcs_cart_link_title', 'Cart: total !total_quantity items for !amount products'),
	);
	

	// Product Single View admin settings
	$form['pwcs_psv_options'] = array('#type' => 'fieldset', '#title' => t('Product View Style or Pagination Number for a Category/Listing'));
	$form['pwcs_psv_options']['#prefix'] = '<div id="pwcs_psv_options">';
	$form['pwcs_psv_options']['#suffix'] = '</div>';
	$form['pwcs_psv_options']['#collapsible'] = 1;
	$form['pwcs_psv_options']['#collapsed'] = 1;
	$form['pwcs_psv_options']['pwcs_categorypage_products_paging_amount'] = array(
		'#type' => 'textfield',
		'#title' => t('Category/Listing Page Paging Amount'),
		'#description' => t('Paging Amount'),
		'#default_value' => variable_get('pwcs_categorypage_products_paging_amount', '10'),
	);	
	
	$product_block_themes = pwcs_product_single_view_options();
	$form['pwcs_psv_options']['pwcs_sitesettings_productview_theme'] = array(
		'#type' => 'radios',
		'#options' => $product_block_themes,
		'#title' => t('Product View Theme'),
		'#description' => t('Selected theme will shown in product search and category page'),
		'#default_value' => variable_get('pwcs_sitesettings_productview_theme', 'spv_normal'),
	);
	// Details Page  block settings
	$form['pwcs_product_detail_page'] = array('#type' => 'fieldset', '#title' => t('Related Products'));
	$form['pwcs_product_detail_page']['#prefix'] = '<div id="pwcs_product_detail_page">';
	$form['pwcs_product_detail_page']['#suffix'] = '</div>';
	$form['pwcs_product_detail_page']['#collapsible'] = 1;
	$form['pwcs_product_detail_page']['#collapsed'] = 1;

	$form['pwcs_product_detail_page']['pwcs_sitesettings_product_detail_relatedproducts'] = array(
		'#type' => 'checkbox',
		'#title' => t('Show Related Products Tab in Product Details Page'),
		//'#description' => t('For Every Single Product View your End User will see Manufacturer Details under Manufacturer Tab'),
		'#default_value' => variable_get('pwcs_sitesettings_product_detail_relatedproducts', '1'),
	);
	$form['pwcs_product_detail_page']['pwcs_sitesettings_cart_relatedproductamount'] = array(
		'#type' => 'textfield',
		'#title' => t('No. of Related Products to be shown in the Soft Add To Cart Popup'),
		//'#description' => t('No of Related Products showing in the Soft Add To Cart Popup'),
		'#default_value' => variable_get('pwcs_sitesettings_cart_relatedproductamount', '5') ,
		'#maxlength' => 180,
		//'#style'=> 'width: 250px;'
	);
	

	

	// Product Settings Others
	$form['pwcs_others_settings'] = array('#type' => 'fieldset', '#title' => t('Product Settings (One Click Buy Text, Add To Cart Text, More Details Text, Sale Price Icon Display ) Others'));
	$form['pwcs_others_settings']['#prefix'] = '<div id="pwcs_others_settings">';
	$form['pwcs_others_settings']['#suffix'] = '</div>';
	$form['pwcs_others_settings']['#collapsible'] = 1;
	$form['pwcs_others_settings']['#collapsed'] = 1;

    // Enable/Disable One Click Buy for the whle Site
	$form['pwcs_others_settings']['pwcs_sitesettings_oneclickbuy'] = array(
		'#type' => 'checkbox',
		'#title' => t('Enable One Click Buy Link'),
		//'#description' => t('To Enable One Click Buy Link For This Site'),
		'#default_value' => variable_get('pwcs_sitesettings_oneclickbuy', '1'),
	);
	$form['pwcs_others_settings']['pwcs_sitesettings_oneclickbuy_text'] = array(
		'#type' => 'textfield',
		'#title' => t('Text For One Click Buy Link'),
		'#description' => t('Set/Change One Click Buy Link Text'),
		'#default_value' => variable_get('pwcs_sitesettings_oneclickbuy_text', 'One Click Buy'),
	);
	
	//Add To Cart at product details page
//	$form['pwcs_others_settings']['pwcs_productdetails_addtocartlink'] = array(
//		'#type' => 'checkbox',
//		'#title' => t('Enable Add To Cart Link (Product Details Page)'),
//		//'#description' => t('Enable Add To Cart Link at Product List Page'),
//		'#default_value' => variable_get('pwcs_productdetails_addtocartlink', '1'),
//	);
	$form['pwcs_others_settings']['pwcs_productdetails_addtocartlink_text'] = array(
		'#type' => 'textfield',
		'#title' => t('Text For Add To Cart (Product Details Page)'),
		'#description' => t('Set/Change Add To Cart Link Text'),
		'#default_value' => variable_get('pwcs_productdetails_addtocartlink_text', 'Add To Cart'),
	);
	
	//Add To Cart at Single Product View SPV
//	$form['pwcs_others_settings']['pwcs_spv_addtocartlink'] = array(
//		'#type' => 'checkbox',
//		'#title' => t('Enable Add To Cart Link (Product List Page)'),
//		//'#description' => t('Enable Add To Cart Link at Product List Page'),
//		'#default_value' => variable_get('pwcs_spv_addtocartlink', '1'),
//	);
	$form['pwcs_others_settings']['pwcs_spv_addtocartlink_text'] = array(
		'#type' => 'textfield',
		'#title' => t('Text For Add To Cart (Product List Page)'),
		'#description' => t('Set/Change Add To Cart Link Text'),
		'#default_value' => variable_get('pwcs_spv_addtocartlink_text', 'Add To Cart'),
	);

	//More Details at Single Product View SPV
	$form['pwcs_others_settings']['pwcs_spv_moredetailslink'] = array(
		'#type' => 'checkbox',
		'#title' => t('Show More Details Link at Product List Page'),
		//'#description' => t('This Will Show More Details Link at Product List Page'),
		'#default_value' => variable_get('pwcs_spv_moredetailslink', '1'),
	);
	$form['pwcs_others_settings']['pwcs_spv_moredetailslink_text'] = array(
		'#type' => 'textfield',
		'#title' => t('Text For More Details'),
		'#description' => t('Set/Change More Details Link Text'),
		'#default_value' => variable_get('pwcs_spv_moredetailslink_text', 'More Details'),
	);

	$form['pwcs_others_settings']['pwcs_addtoany_enable'] = array(
		'#type' => 'checkbox',
		'#title' => t('Enable Share Button At Product Details Page'),
		'#description' => t('Enable/Disable "AddToAny" Share Button at the bottom of product details page'),
		'#default_value' => variable_get('pwcs_addtoany_enable', '0'),
	);

	// Product Settings Others
	$form['pwcs_others_settings']['pwcs_product_saleprice'] = array('#type' => 'fieldset', '#title' => t('Product Sale Price Icon'));
	$form['pwcs_others_settings']['#prefix'] = '<div id="pwcs_product_saleprice" class="radios-inline">';
	$form['pwcs_others_settings']['#suffix'] = '</div>';
	$form['pwcs_others_settings']['pwcs_product_saleprice']['#collapsible'] = 0;
	$form['pwcs_others_settings']['pwcs_product_saleprice']['#collapsed'] = 0;

	$icon_option = array(''=>'<em>'.t('No Icon').'</em>');
	$pwcs_salepriceicon_files = file_scan_directory(PWCS_MODULE_IMAGE.'saleprice_icons', '.png');
	foreach($pwcs_salepriceicon_files as $k=>$v){
		$saleprice_icon_option[$v->filename] = theme('image', $v->filename, '', '', array('width'=>'auto'), FALSE);
	}
	//SALE icon
	$form['pwcs_others_settings']['pwcs_product_saleprice']['pwcs_product_saleprice_icon_1'] = array(
		'#type' => 'radios',
		'#options' => $saleprice_icon_option,
		'#title' => t('Prodcuts Sell Price Icon for SALE'),
		'#description' => t('Icon you want to show with your product saleprice of Sale'),
		'#default_value' => variable_get('pwcs_product_saleprice_icon_1', PWCS_MODULE_IMAGE.'saleprice_icons'.'/saletag1.png'),
	);
	//CLEARANCE icon
	$form['pwcs_others_settings']['pwcs_product_saleprice']['pwcs_product_saleprice_icon_2'] = array(
		'#type' => 'radios',
		'#options' => $saleprice_icon_option,
		'#title' => t('Prodcuts Sell Price Icon for CLEARANCE'),
		'#description' => t('Icon you want to show with your product saleprice of Clearance'),
		'#default_value' => variable_get('pwcs_product_saleprice_icon_2', PWCS_MODULE_IMAGE.'saleprice_icons'.'/saletag2.png'),
	);
	//CLOSEOUT icon
	$form['pwcs_others_settings']['pwcs_product_saleprice']['pwcs_product_saleprice_icon_3'] = array(
		'#type' => 'radios',
		'#options' => $saleprice_icon_option,
		'#title' => t('Prodcuts Sell Price Icon for CLOSEOUT'),
		'#description' => t('Icon you want to show with your product saleprice of Closeout'),
		'#default_value' => variable_get('pwcs_product_saleprice_icon_3', PWCS_MODULE_IMAGE.'saleprice_icons'.'/saletag3.png'),
	);

	// Video Settings
	$form['pwcs_videodisplay_settings'] = array('#type' => 'fieldset', '#title' => t('Video Settings'));
	$form['pwcs_videodisplay_settings']['#prefix'] = '<div id="pwcs_videodisplay_settings">';
	$form['pwcs_videodisplay_settings']['#suffix'] = '</div>';
	$form['pwcs_videodisplay_settings']['#collapsible'] = 1;
	$form['pwcs_videodisplay_settings']['#collapsed'] = 1;

	$form['pwcs_videodisplay_settings']['pwcs_product_video_showat_productdetails'] = array(
		'#type' => 'checkbox',
		'#title' => t('Show Video Links At Product Details Page'),
		'#description' => t('For Every Single Product View your End User will see Videos'),
		'#default_value' => variable_get('pwcs_product_video_showat_productdetails', '1'),
	);
	$icon_option = array(
				''=>'<em>'.t('No Icon').'</em>', 
				'auto_thumb'=> theme('image', PWCS_MODULE_IMAGE.'video_thumb_default.jpg', '', '', array('width'=>'auto'), FALSE).' ('.t('Auto Generated Thumbnail').')'
				);
	$pwcs_files = file_scan_directory(PWCS_MODULE_IMAGE.'icons', '.*');
	foreach($pwcs_files as $k=>$v){
		$icon_option[$v->filename] = theme('image', $v->filename, '', '', array('width'=>'auto'), FALSE).' ('.t('PWCStore Provided Icon').')';
	}
	$user_files = file_scan_directory(file_directory_path().'/imagelibrary/icons', '.*');
	foreach($user_files as $k=>$v){
		$icon_option[$v->filename] = theme('image', $v->filename, '', '', array('width'=>'auto'), FALSE).' ('.t('Uploaded Icon').')';
	}
	$form['pwcs_videodisplay_settings']['pwcs_product_video_icon'] = array(
		'#type' => 'radios',
		'#options' => $icon_option,
		'#title' => t('Prodcuts Video Icon'),
		'#description' => t('Icon you want to show with your product videos'),
		'#default_value' => variable_get('pwcs_product_video_icon', ''),
	);
	$form['pwcs_videodisplay_settings']['pwcs_product_video_icon_text'] = array(
		'#type' => 'textfield',
		'#title' => t('Prodcuts Video Icon Text'),
		'#description' => t('Text you want to show with your product videos.<br><b>!video_title</b> can be used as a variable of video title.<br>Example: Play Video (!video_title), Play "!video_title" Now'),
		'#default_value' => variable_get('pwcs_product_video_icon_text', 'Play Video'),
	);

    // Product Review settings

    if(variable_get('pwcs_sitesettings_product_detail_productreview', '1') == 1) {
      //Enable Comments for All Products
      db_query("UPDATE {node} SET `comment` = 2 WHERE `type`='product'");
    }
	
	$form['pwcs_productreview_settings'] = array('#type' => 'fieldset', '#title' => t('Product Review Settings'));
	$form['pwcs_productreview_settings']['#prefix'] = '<div id="pwcs_productreview_settings">';
	$form['pwcs_productreview_settings']['#suffix'] = '</div>';
	$form['pwcs_productreview_settings']['#collapsible'] = 1;
	$form['pwcs_productreview_settings']['#collapsed'] = 1;

	$form['pwcs_productreview_settings']['pwcs_sitesettings_productreview_tab'] = array(
		'#type' => 'checkbox',
		'#title' => t('Show Product Reviews Tab'),
		'#description' => t('For Every Single Product View your End User will see Reviews of that Product under Product Reviews Tab'),
		'#default_value' => variable_get('pwcs_sitesettings_product_detail_productreview', '1'),
	);

	$form['pwcs_productreview_settings']['pwcs_sitesettings_productreview_approvecomments'] = array(
		'#type' => 'checkbox',
		'#title' => t('Enable Siteadmin Approval For Product Review'),
		'#default_value' => variable_get('pwcs_sitesettings_productreview_approvecomments', '1'),
	);
	//Set comment permissions for anonymous user = 1
	if(variable_get('pwcs_sitesettings_productreview_approvecomments', '1') == 1) {
		pwcs_removepermission('post comments without approval' , 'anonymous user');
	} else {
		pwcs_addpermission('post comments without approval' , 'anonymous user');
	}

	$form['pwcs_productreview_settings']['fivestar_product'] = array(
		'#type' => 'checkbox',
		'#title' => t('Enable Fivestar rating'),
		'#description' => t("At Product Reviews Tab You can enable/disbale fivestar rating for each comment. " .
							"<br />To change the UI of Fivestar got to <strong>!url</strong>", array('!url' => l(t('FIVE STAR SETTINGS'), 'admin/settings/fivestar', array('html' => true, 'query' => 'destination=siteadmin/sitesettings')))),
		'#default_value' => variable_get('fivestar_product', '1'),
	);
	
	// Manufacture block settings
	$form['pwcs_manufacturer_block'] = array('#type' => 'fieldset', '#title' => t('Manufacturer Settings'));
	$form['pwcs_manufacturer_block']['#prefix'] = '<div id="pwcs_manufacturer_block">';
	$form['pwcs_manufacturer_block']['#suffix'] = '</div>';
	$form['pwcs_manufacturer_block']['#collapsible'] = 1;
	$form['pwcs_manufacturer_block']['#collapsed'] = 1;

	$form['pwcs_manufacturer_block']['pwcs_sitesettings_product_detail_show_manufacturer'] = array(
		'#type' => 'checkbox',
		'#title' => t('Show Manufacturer Tab in Product Details Page'),
		//'#description' => t('For Every Single Product View your End User will see Manufacturer Details under Manufacturer Tab'),
		'#default_value' => variable_get('pwcs_sitesettings_product_detail_show_manufacturer', '1'),
	);
	
	$form['pwcs_manufacturer_block']['pwcs_manufacturer_block_type'] = array(
		'#type' => 'radios',
		'#options' => array(0=>t('Random Manufacturer'), 1=>t('Featured Manufacturer')),
		'#title' => t('Manufacturer block items will be'),
		'#description' => t('Selected way will be shown in Manufacturer block.').' '.l('Go to this link to EDIT "Featured Manufacturer".', 'siteadmin/manufacturers'),
		'#default_value' => variable_get('pwcs_manufacturer_block_type', '0'),
	);
	$form['pwcs_manufacturer_block']['pwcs_manufacturer_block_item_amount'] = array(
		'#type' => 'textfield',
		'#title' => t('Maximum Manufacturer No in Manufacture Block (If random selected)'),
		'#description' => t('No. of Manufacturer which will be set in Manufacturer Block if the block is enabled.'),
		'#default_value' => variable_get('pwcs_manufacturer_block_item_amount', '10'),
	);	

	// Category/Listing settings
	$form['pwcs_category_listing_settings'] = array('#type' => 'fieldset', '#title' => t('Category/Listing Settings'));
	$form['pwcs_category_listing_settings']['#prefix'] = '<div id="pwcs_category_listing_settings">';
	$form['pwcs_category_listing_settings']['#suffix'] = '</div>';
	$form['pwcs_category_listing_settings']['#collapsible'] = 1;
	$form['pwcs_category_listing_settings']['#collapsed'] = 1;

	$form['pwcs_category_listing_settings']['pwcs_listing_menu_count'] = array(
		'#type' => 'checkbox',
		'#title' => t('Show Item Count For Category/Listing Menu'),
		//'#description' => t('For Every Single Product View your End User will see Manufacturer Details under Manufacturer Tab'),
		'#default_value' => variable_get('pwcs_listing_menu_count', '1'),
	);
	$form['pwcs_category_listing_settings']['pwcs_listings_menu_tree_options'] = array(
		'#type' => 'radios',
		'#title' => t('Category/Listing Menu - Item Count Option'),
		'#options' => array(
						0 => t('Show Individual Product Count For Each Category/List Item'),
						1 => t('Show Total Product Count From Child Category/List Item')
					  ),
		'#default_value' => variable_get('pwcs_listings_menu_tree_options', 0),
	);


	$form['bottom']['#type'] = 'item';
	$form['bottom']['#prefix'] = '';
	$form['bottom']['#suffix'] = '<div style="padding:10px;"></div>';

	return system_settings_form($form);
}

function pwcs_sync()
{
	global $user,$finalmsgs;
	

	$finalmsgs = array();

	cache_clear_all();
  	drupal_flush_all_caches();
	unset($_SESSION['messages']);

	$merchant_id='';
	$api_key='';

	$sql  = "SELECT * FROM {pwcs_autosync} async";
	$results = db_query($sql);
	while($result = db_fetch_object($results))
	{
		$merchant_id         = $result->merchantid;
		$api_key             = $result->apisignature;
		$merchantfirstname   = $result->merchantfirstname;
		$merchantlastname    = $result->merchantlastname;
		$merchantemail       = $result->merchantemail;
		$merchantcompanyname = $result->merchantcompanyname;
		$merchantwebaddress  = $result->merchantwebaddress;
		$merchantsubdomain   = $result->merchantsubdomain;
	}

	
	if ( (!empty($merchant_id)) && (!empty($api_key)) )
	{
		
		syncBasicSettings($merchant_id, $api_key);
		syncCategory($merchant_id, $api_key);
		syncListing($merchant_id, $api_key);
		syncProducts($merchant_id, $api_key);
		syncAttributes($merchant_id, $api_key);
		syncManufacturer($merchant_id, $api_key);
		syncProductsWithListing();
		pwcs_update_listing_table();
	}
	
	if (!empty($merchantsubdomain))
	variable_set('file_directory_path', 'sites/'.$merchantsubdomain.'.pwcstores.com/files');

	if (!empty($merchantcompanyname))
	variable_set('site_name', $merchantcompanyname.' Store');

	if (!empty($merchantemail))
	variable_set('site_mail', $merchantemail);

	if(!empty($merchantcompanyname))
	variable_set('site_footer', 'copyright @ '.date('Y').', '.$merchantcompanyname.'');
	else
	variable_set('site_footer', 'copyright @ '.date('Y').', Premium Web Cart Inc.');

	if(!empty($merchantlastname))
		$merchantusername = strtolower($merchantlastname);
	else if(!empty($merchantfirstname))
		$merchantusername = strtolower($merchantfirstname);
	else
		$merchantusername = 'demo';

	if(!empty($merchantlastname))
		$merchantname = $merchantlastname;
	else if(!empty($merchantfirstname))
		$merchantname = $merchantfirstname;
	else
		$merchantname = 'Merchant';

	$updateemail = db_query("UPDATE {users} SET name='".$merchantusername."', mail='".$merchantemail."',init='".$merchantemail."',merchant_enc_id='".$merchant_id."',site_api_key='".$api_key."' WHERE uid = '2'");

	
	
	$message = array(
	  'to' => $merchantemail,
	  'subject' => t('Your PWC Store Account has been Created'),
	  'body' => 'Dear '.$merchantname.'<br/><br/> Your Store Account has been Created Successfully.<br/><br/>Your Store URL: http://'.$merchantsubdomain.'.pwcstores.com/<br/><br/><br/>Your Store Admin URL: http://'.$merchantsubdomain.'.pwcstores.com/user<br/><br/>User Name: '.$merchantusername.'<br/>Password: 654321<br/><br/><br/>Thanks<br/>Premium Web Cart Inc. Team',
	  'headers' => array(
          'From' => 'webmaster@pwcart.com',
          'MIME-Version' => '1.0',
          'Content-Type' => 'text/html;charset=utf-8',),
          'Reply-To' => 'webmaster@pwcart.com',
	);

	drupal_mail_send($message);
	
	$message = array(
	  'to' => 'zerin@pwcart.com',
	  'subject' => t('A Merchant PWC Store Account has been Created'),
	  'body' => 'Dear ZERIN<br/> Merchant Name: '.$merchantname.'<br/><br/> Merchant Store Account has been Created Successfully.<br/><br/>Merchant Store URL: http://'.$merchantsubdomain.'.pwcstores.com/<br/><br/><br/>Merchant Store Admin URL: http://'.$merchantsubdomain.'.pwcstores.com/user<br/><br/>User Name: '.$merchantusername.'<br/>Password: 654321<br/><br/><br/>Thanks<br/>Premium Web Cart Inc. Team',
	  'headers' => array(
          'From' => 'webmaster@pwcart.com',
          'Reply-To' => 'webmaster@pwcart.com',
          'MIME-Version' => '1.0',
          'Content-Type' => 'text/html;charset=utf-8',),
	);

	drupal_mail_send($message);		
	


	
	$message = array(
	  'to' => 'a.r.zerin@athena-soft.com',
	  'subject' => t('A PWC Store Account has been Created'),
	  'body' => 'Dear '.$merchantname.'<br/><br/> Your Store Account has been Created Successfully.<br/><br/>Your Store URL: http://'.$merchantsubdomain.'.pwcstores.com/<br/><br/><br/>Your Store Admin URL: http://'.$merchantsubdomain.'.pwcstores.com/user<br/><br/>User Name:'.$merchantusername.'<br/>Password:654321<br/><br/><br/>Thanks<br/>Premium Web Cart Inc. Team',
	  'headers' => array(
          'From' => 'webmaster@pwcart.com',
          'Reply-To' => 'webmaster@pwcart.com',
          'MIME-Version' => '1.0',
          'Content-Type' => 'text/html;charset=utf-8',),
	);

	drupal_mail_send($message);	

	die('DONE');
}
/**
 * API Function
 *
 * This function is called whenever any product is created or updated in PWCCORE
 * This function also get calls whenver any category is created or updated in PWCCORE
 *
 * @todo Currently we do not delete anything
 *       when a product or category will be deleted on PWCCORE
 *
 * @author A.R. ZERIN <a.r.zerin@gmail.com>
 * @version 1.0
 * @copyright
 * @package PWC Store
 * @link http://project_url/api/
 * @example http://www.pwcstores.com/api/
 * @access public
 * @param array [$type]
 * @see  $items['api']
 *
 * @global array $user
 *
 * @usedby api
 *
 * @last-modified on 26 October, 2010 by A.R. ZERIN <a.r.zerin@gmail.com>
 *
 * @return NULL, nothing to return
 *
 */
function pwcs_api($type = NULL){

	pwcs_debug_file_write($_REQUEST, true);

	global $user;
	$entity = isset($_REQUEST['entity']) ? $_REQUEST['entity'] : '';
	$status = isset($_REQUEST['status']) ? $_REQUEST['status'] : '';

	switch ($entity)
	{
		case 'product':     //If notification comes for Product

	    if($_POST['status'] == 'created' || $_POST['status'] == 'updated' || $_POST['status'] == 'deleted')
	    {
    	//Fetching all the data from POST Notification (Start)
        $product_row_id        = $_POST['product_row_id']        ? $_POST['product_row_id']        : '';
        $product_short_desc    = $_POST['shortDesc']             ? $_POST['shortDesc']             : '';
		    $product_long_desc     = $_POST['longDesc']              ? $_POST['longDesc']              : '';
	    	$product_manufac_info  = $_POST['manufactureInfo']       ? $_POST['manufactureInfo']       : '';
	    	$product_manufac_id    = $_POST['manufacturer_id']       ? $_POST['manufacturer_id']       : 0;
        $product_link_id       = $_POST['link_id']               ? $_POST['link_id']               : '';
        $product_name          = $_POST['product_name']          ? $_POST['product_name']          : '';
        $product_sku           = $_POST['product_sku']           ? $_POST['product_sku']           : '';
        $product_category_id   = $_POST['category_id']           ? $_POST['category_id']           : '0';
        $product_price         = $_POST['price']                 ? $_POST['price']                 : '0.00';
        $regular_buy_link      = $_POST['regular_buy_link']      ? $_POST['regular_buy_link']      : '';
        $one_click_buy_link    = $_POST['one_click_buy_link']    ? $_POST['one_click_buy_link']    : '';
        $p_created_on          = $_POST['created_on']            ? $_POST['created_on']            : '0000-00-00';
        $p_modified_on         = $_POST['modified_on']           ? $_POST['modified_on']           : '0000-00-00';
        $product_image         = $_POST['product_image']         ? $_POST['product_image']         : '';
        
        $enable_sales_price    = $_POST['enable_sales_price']    ? $_POST['enable_sales_price']    : 0;
        $product_sale_price    = $_POST['product_sale_price']    ? $_POST['product_sale_price']    : 0;
        $sale_tag_icon         = $_POST['sale_tag_icon']         ? $_POST['sale_tag_icon']         : 0;
        $sale_price_start_date = $_POST['sale_price_start_date'] ? strtotime($_POST['sale_price_start_date']) : 0;
        $sale_price_end_date   = $_POST['sale_price_end_date']   ? strtotime($_POST['sale_price_end_date'])   : 0;
    	//Fetching all the data from POST Notification (End)


        //If there is not product_row_id, product_name, regular buy link & one click buy link then
        //we will not process
        
        //$product_name = stripslashes(mysql_escape_string($product_name));
				$product_name = html_entity_decode($product_name);

        if($product_row_id && $product_link_id && $product_name && $regular_buy_link && $one_click_buy_link)
        {
            // We have received notification after a product has been updated in PWCCORE
            if($_POST['status'] == 'updated')
            {
        	    //We are collecting node value for existing product from PWCSTORE
        	    $product_nid = db_result(db_query('SELECT nid FROM {pwcs_product} WHERE pwc_product_row_id = %d', $product_row_id));

            	    $node = node_load($product_nid);
				    $node->title                = $product_name; //stripslashes(mysql_escape_string($product_name));
				    $node->body                 = '';
				    $node->product_name         = $product_name;
				    $node->teaser               = $product_short_desc;
				    $node->body                 = $product_long_desc;
				    $node->product_manufacture  = $product_manufac_info;
				    $node->manufacturer_id      = $product_manufac_id;
				    $node->pwc_product_row_id   = $product_row_id;
				    $node->product_link_id      = $product_link_id;
				    $node->product_sku          = $product_sku;
				    $node->pwc_category_id      = $product_category_id;
				    $node->price          	    = $product_price;
				    $node->regular_buy_link     = $regular_buy_link;
				    $node->one_click_buy_link   = $one_click_buy_link;
				    //$node->product_image_path = $product_image;
				    $node->modified_on          = time();
				    $node->is_sync          	= 1;
				    $node->changed         	    = time();

						$node->sync_api          	= 1; // not for DB, status flag to detect node_save
	
						$node->issalespriceactive  = $enable_sales_price; 
						$node->salesprice          = $product_sale_price; 
						$node->salestag            = $sale_tag_icon; 
						$node->salepricestartdate  = $sale_price_start_date; 
						$node->salepriceenddate    = $sale_price_end_date; 
		
	
						node_save($node);
						pwcs_update_listing_table();
						pwcs_make_order_table();
            }//End of if($_POST['status'] == 'updated')

            // We have received notification after a new product has been created in PWCCORE
            if($_POST['status'] == 'created')
            {
					    $node = new stdClass();
					    $node->uid                  = $user->uid;
					    $node->type                 = 'product';
					    $node->title                = $product_name;
					    $node->product_name         = $product_name;
					    $node->teaser               = $product_short_desc;
					    $node->body                 = $product_long_desc;
					    $node->product_manufacture  = $product_manufac_info;
					    $node->manufacturer_id      = $product_manufac_id;
					    $node->pwc_product_row_id   = $product_row_id;
					    $node->product_link_id      = $product_link_id;
					    $node->product_sku          = $product_sku;
					    $node->pwc_category_id      = $product_category_id;
					    $node->price          	    = $product_price;
					    $node->regular_buy_link     = $regular_buy_link;
					    $node->one_click_buy_link   = $one_click_buy_link;
					    //$node->product_image_path   = $product_image;
					    $node->created_on           = time();
					    $node->modified_on          = time();
					    $node->is_sync          	= 1;
					    $node->changed         	    = time();

					    $node->sync_api          	= 1; // not for DB, status flag to detect node_save
						    
							$node->issalespriceactive  = $enable_sales_price; 
							$node->salesprice          = $product_sale_price; 
							$node->salestag            = $sale_tag_icon; 
							$node->salepricestartdate  = $sale_price_start_date; 
							$node->salepriceenddate    = $sale_price_end_date; 
						    
					    
			    		node_save($node);
			    		pwcs_update_listing_table();
			    		pwcs_make_order_table();
            }//End of if($_POST['status'] == 'created')
        }//End of  if($product_row_id && $product_link_id && $product_name && $regular_buy_link && $one_click_buy_link)
   	 	if($_POST['status'] == 'deleted')
    	{
    	  	$node_id =  pwcs_get_product_nid($product_row_id);
    	  	if($node_id >0)
    	  	node_delete($node_id);
			$sql = " DELETE FROM {pwcs_product} ".
		    	   " WHERE pwc_product_row_id	 = '%d' LIMIT 1";
	        db_query($sql,$product_row_id);
    	  	pwcs_make_order_table();
    	 }
    	}//if($_POST['status'] == 'created' || $_POST['status'] == 'updated' || $_POST['status'] == 'deleted')

		break;

		case 'category': //If notification comes for Category

	    if($_POST['status'] == 'created' || $_POST['status'] == 'updated')
	    {
	        $category_id         = $_POST['category_id']           ? $_POST['category_id']            : '';
	        $category_title      = $_POST['category_description']  ? $_POST['category_description']   : '';
	        $parent_category_id  = $_POST['parent_category_id']    ? $_POST['parent_category_id']     : 0;
	        $category_level      = $_POST['level']                 ? $_POST['level']                  : 0;
	        $has_child           = $_POST['has_child']             ? $_POST['has_child']              : 0;
	        $is_editable         = $_POST['is_editable']           ? $_POST['is_editable']            : 1;
	        $created_on          = $_POST['created_on']            ? $_POST['created_on']             : time();
	        $modified_on         = $_POST['modified_on']           ? $_POST['modified_on']            : time();

	            // We have received notification after a new category has been created in PWCCORE
	            if($_POST['status'] == 'created')
	            {
					$category=array();
					$category['category_title']     = stripslashes(mysql_escape_string($category_title));
					$category['parent_category_id'] = $parent_category_id;
					$category['weight']             = 0;
					$category['created_on']         = $created_on;

					$result = db_query("INSERT INTO {pwcs_category}" .
							" (`pwc_category_id`, `category_title`,`parent_category_id`,`weight`,`created_on`)" .
							" VALUES (%d, '%s', %d, %d, %d)",
							$category_id, $category_title, $parent_category_id, 0, $created_on
					);
					$result = db_query("INSERT INTO {pwcs_listings}" .
							" (`pwc_category_id`, `category_title`,`parent_category_id`,`category_type`, `is_editable`,`weight`,`created_on`)" .
							" VALUES (%d, '%s', %d, %d, %d, %d, %d)",
							$category_id, $category_title, $parent_category_id, 0, 1, 0, $created_on
					);
					pwcs_update_listing_table();
					pwcs_make_order_table();
	            }//End of if($_POST['status'] == 'created')

	            // We have received notification after an existing category has been updated in PWCCORE
	            if($_POST['status'] == 'updated')
	            {
					$category=array();
					$category['category_title']      = stripslashes(mysql_escape_string($category_title));
					$category['parent_category_id']  = $parent_category_id;
					$category['weight']              = 0;
					$category['created_on']          = $created_on;
					$category['modified_on']         = $modified_on;

					$result = db_query("UPDATE {pwcs_category}
						SET `category_title`='%s', `parent_category_id`= %d, `modified_on`=%d WHERE pwc_category_id = %d",
						$category['category_title'], $category['parent_category_id'], $category['modified_on'], $category_id
					);
					$result = db_query("UPDATE {pwcs_listings}
						SET `category_title`='%s', `parent_category_id`= %d, `modified_on`=%d WHERE pwc_category_id = %d",
						$category['category_title'], $category['parent_category_id'], $category['modified_on'], $category_id
					);
					pwcs_update_listing_table();
					pwcs_make_order_table();
	            }//End of if($_POST['status'] == 'updated')
	    }//if($_POST['status'] == 'created' || $_POST['status'] == 'updated')

		break;

		case 'manufacturer':

			 $manufacturer_id     = $_POST['manufacturer_id']   ? $_POST['manufacturer_id']    : '';
			 $manufacturer_name   = $_POST['manufacturer_name'] ? $_POST['manufacturer_name']  : '';
			 $created_on          = $_POST['created_on']        ? $_POST['created_on']         : time();
			 $modified_on         = $_POST['modified_on']       ? $_POST['modified_on']        : time();


		    if ($_POST['status'] == 'created' || $_POST['status'] == 'updated' || $_POST['status'] == 'deleted')
		    {
		    	 if($_POST['status'] == 'created')
		    	 {

					$sql = "INSERT INTO {pwcs_manufacturer}".
				    	   " (pwc_mfg_id, mfg_name, is_sync, created_on, modified_on)".
				    	   " VALUES ( %d, '%s', %d, %d, %d)";
			        db_query(	$sql,
			        			$manufacturer_id,
			        			stripslashes(mysql_escape_string($manufacturer_name)),
			        			1,
			        			$created_on,
			        			$modified_on
			        		);
		    	 }
				if($_POST['status'] == 'updated')
		    	 {

					$sql = "UPDATE {pwcs_manufacturer} ".
				    	   " SET mfg_name='%s', modified_on='%s' ".
				    	   " WHERE pwc_mfg_id='%d' ";
			        db_query(	$sql,
			        			stripslashes(mysql_escape_string($manufacturer_name)),
			        			$modified_on,
			        			$manufacturer_id
			        		);
		    	 }
				if($_POST['status'] == 'deleted')
		    	 {
		    	 	$sql = "DELETE FROM {pwcs_manufacturer} ".
				    	   " WHERE pwc_mfg_id = '%d' LIMIT 1";
			        db_query($sql,$manufacturer_id);

					$sql = "UPDATE {pwcs_product} ".
				    	   " SET manufacturer_id='0' ".
				    	   " WHERE manufacturer_id='%d' ";
			        db_query($sql,$manufacturer_id);
		    	 }
		 	}//if($_POST['status'] == 'created' || $_POST['status'] == 'updated' || $_POST['status'] == 'deleted')

		break;

		case 'attributegroup': // ADD EDIT DELETE any Attribute group, i.e. Color, Size, Type etc.

			if($status == 'created'){
				//    [merchant_row_id] => 2
				//    [group_row_id] => 114
				//    [group_name] => type
				//    [is_required] =>
				//    [status] => created
				//    [merchant_id] => MER-00002
				//    [apikey] => PS4s1S3DF5rw5Fod5s4w8e4xds5d7w5e=
				//    [entity] => attributegroup
				$sql = "INSERT INTO {pwcs_attr_groups} (attr_group_public_name, is_required, pwc_group_row_id, weight ) VALUES ( '%s', %d, %d, %d)";
				db_query($sql, stripslashes(mysql_escape_string($_REQUEST['group_name'])), $_REQUEST['is_required'], $_REQUEST['group_row_id'], '');
			}
			else if($status == 'deleted'){
				//    [group_row_id] => 114
				//    [status] => deleted
				//    [merchant_id] => MER-00002
				//    [apikey] => PS4s1S3DF5rw5Fod5s4w8e4xds5d7w5e=
				//    [entity] => attributegroup

				// Get primary key of this Attribute group
				$groupid = db_result(db_query("SELECT id FROM {pwcs_attr_groups} WHERE pwc_group_row_id = %d", $_REQUEST['group_row_id']));

				// Get All pwc_attribute_id of this Attribute group
				$pwc_attribute_id_all = array();
				$results = db_query("SELECT * FROM {pwcs_attributes} WHERE group_id = %d", $groupid);
				while($result = db_fetch_object($results)) {
					$pwc_attribute_id_all[] = $result->pwc_attribute_id;
				}

				// Delete Product-Attributes relation of this group
				foreach ($pwc_attribute_id_all as $k=>$pwc_attribute_id) {
					db_query("DELETE FROM {pwcs_product_attributes} WHERE attr_id LIKE '%,".$pwc_attribute_id.",%' OR attr_id LIKE '".$pwc_attribute_id.",%' OR attr_id LIKE '%,".$pwc_attribute_id."'");
				}

				// Delete Attributes of this group
				db_query("DELETE FROM {pwcs_attributes} WHERE group_id = %d", $groupid);

				// Delete Attribute group
				db_query("DELETE FROM {pwcs_attr_groups} WHERE pwc_group_row_id = %d", $_REQUEST['group_row_id']);

			}
			else if($status == 'updated'){
				//    [merchant_row_id] => 2
				//    [group_row_id] => 1
				//    [group_name] => Colors
				//    [is_required] =>
				//    [status] => updated
				//    [merchant_id] => MER-00002
				//    [apikey] => PS4s1S3DF5rw5Fod5s4w8e4xds5d7w5e=
				//    [entity] => attributegroup
				$sql = "UPDATE {pwcs_attr_groups} SET attr_group_public_name = '%s', is_required = %d WHERE pwc_group_row_id = %d ";
				db_query($sql, stripslashes(mysql_escape_string($_REQUEST['group_name'])), $_REQUEST['is_required'], $_REQUEST['group_row_id']);
			}
			else {
				// Invalid Status
			}

		break;

		case 'attribute':  // ADD EDIT DELETE any Attribute, i.e. Red, Green, XL, L, Male, Female etc.

			if($status == 'created'){
				//    [group_row_id] => 1
				//    [attribute_row_id] => 626
				//    [attribute_name] => Black
				//    [weight] => 5
				//    [status] => created
				//    [apikey] => PS4s1S3DF5rw5Fod5s4w8e4xds5d7w5e=
				//    [entity] => attribute

				$sql = "INSERT INTO {pwcs_attributes} (pwc_attribute_id, group_id, attr_name, weight) VALUES ( %d, %d, '%s', %d)";
				db_query($sql, $_REQUEST['attribute_row_id'], pwcs_get_store_attr_group_id($_REQUEST["group_row_id"]), stripslashes(mysql_escape_string($_REQUEST['attribute_name'])),$_REQUEST['weight']);
			}
			if($status == 'deleted'){
				//    [attribute_row_id] => 626
				//    [status] => deleted
				//    [apikey] => PS4s1S3DF5rw5Fod5s4w8e4xds5d7w5e=
				//    [entity] => attribute

				// Delete Product-Attributes relation of this group
				db_query("DELETE FROM {pwcs_product_attributes} WHERE attr_id LIKE '%,".$_REQUEST['attribute_row_id'].",%' OR attr_id LIKE '".$_REQUEST['attribute_row_id'].",%' OR attr_id LIKE '%,".$_REQUEST['attribute_row_id']."'");

				// Delete Attributes of this group
				db_query("DELETE FROM {pwcs_attributes} WHERE pwc_attribute_id = %d", $_REQUEST['attribute_row_id']);
			}
			else if($status == 'updated'){
				//    [group_row_id] => 1
				//    [attribute_row_id] => 4
				//    [attribute_name] => Green
				//    [weight] => 0
				//    [status] => updated
				//    [apikey] => PS4s1S3DF5rw5Fod5s4w8e4xds5d7w5e=
				//    [entity] => attribute
				$sql = "UPDATE {pwcs_attributes} SET attr_name = '%s', weight = %d WHERE pwc_attribute_id = %d ";
				db_query($sql, $_REQUEST['attribute_name'], $_REQUEST['weight'], $_REQUEST['attribute_row_id']);
			}
			else if($status == 'assigned'){

				//    [product_row_id] => 5060
				//    [price_change] => -5
				//    [quantity] => 7
				//    [sub_sku] => BM-2011
				//    [attribute_row_id] => 617,627
				//    [is_default] => 1
				//    [status] => assigned
				//    [apikey] => PS4s1S3DF5rw5Fod5s4w8e4xds5d7w5e=
				//    [entity] => attribute

				//pwcs_debug_file_write($_REQUEST, true);

				$attributerowid = $_REQUEST['attribute_row_id'];
				$attributerowid_tmp = explode(",",$attributerowid);
				sort($attributerowid_tmp);
				$attributerowid = implode(",",$attributerowid_tmp);
    		$sql = " INSERT INTO {pwcs_product_attributes} (nid, attr_id, quantity, affected_price, subsku ) VALUES ( %d, '%s', %d, %f, '%s')";
			  db_query($sql, pwcs_get_product_nid($_REQUEST['product_row_id']),$attributerowid, $_REQUEST['quantity'],$_REQUEST['price_change'],$_REQUEST['sub_sku']);
			  if($_REQUEST['is_default'] == 1){
					db_query("UPDATE {pwcs_product}	SET `default_attribute`='%s' WHERE nid = %d", $attributerowid, pwcs_get_product_nid($_REQUEST['product_row_id']));
			  }
			}
			else if($status == 'unassigned'){
				//    [status] => unassigned
				//    [attribute_row_id] => 617,627
				//    [product_row_id] => 5060
				//    [apikey] => PS4s1S3DF5rw5Fod5s4w8e4xds5d7w5e=
				//    [entity] => attribute
				$attributerowid = $_REQUEST['attribute_row_id'];
				$attributerowid_tmp = explode(",",$attributerowid);
				sort($attributerowid_tmp);
				$attributerowid = implode(",",$attributerowid_tmp);
				db_query("DELETE FROM {pwcs_product_attributes} WHERE nid = %d AND attr_id = '%s'", pwcs_get_product_nid($_REQUEST['product_row_id']), $_REQUEST['attribute_row_id']);
				db_query("UPDATE {pwcs_product}	SET `default_attribute`='%s' WHERE `default_attribute` = '%s' AND nid = %d", $attributerowid, $attributerowid, pwcs_get_product_nid($_REQUEST['product_row_id']));
			}
			else {
					// Invalid status
			}
		break;

		case 'sync':     //If notification comes for Quick Sync

				/*
				$merchant_id = $_POST['merchantid'];


				pwcs_debug_file_write($_POST, true);
				die();

			    if($_POST['status'] == 'update')
			    {
			    // Will get merchant email address, merchant web address, company name, merchant full name, email the merchant,
			    // Will get merchant last name & then convert it to small letter,
			    // Will create my web site list also
			    // Will collect the merchnat API key & if not then will create in PWC
			    // Will save the domain name at pWC for cart api auto
			    // Will sync for the merchant

				$response = pwcs_getMerchantInformation();
			    pwcs_debug_file_write('Response Data:'.$response);

				if (module_exists('xml_parser')){
					$response = xml_clean($response);
					$response_array = xml_parser_string_to_array($response);
				} else
					$response_array = 'module not enabled';

				pwcs_debug_file_write($response_array, true);

				//echo $response_array['merchantfirstname'];
				variable_set('file_directory_path', 'sites/default2/files');
				variable_set('site_name', 'My Store Site');
				variable_set('site_mail', 'a.r.zerin@gmail.com');
				variable_set('site_footer', 'copyright @ '.date('Y').', Premium Web Cart Inc.');


				$updateemail = db_query("UPDATE {users} SET name='".strtolower($response_array['merchantlastname'])."', mail='a.r.zerin@gmail.com',init='a.r.zerin@gmail.com',merchant_enc_id='',site_api_key='' WHERE uid = '2'");


			    }
				*/
		default:
			// Invalid API Request
		break;
  }
	return null;
}

/**
 * The Purpose of this function to redirect the Admin or User to the Login Page
 * This is just a user friendly task, it is easy to memorize the login word
 */
function user_login_page() {
	global $user;
	$tmp = NULL;
	session_destroy();
	user_module_invoke('logout', $tmp, $user);
	$user = drupal_anonymous_user();	
	drupal_goto('user');
}


function pwcs_admin_sync_settings($done = NULL) {

	if($done != 'done') {

		drupal_set_message(t('Synchronization may take couple of minutes.'), 'warning');


		drupal_set_message(t('Synchronization will delete all Products Images that you have uploaded from Store Site. You should use this Synchronization only if you see that, Products in PWC Store is not upto date with Products in Premium Web Cart, otherwise You should not use Synchronization feature.'), 'error');
		drupal_set_message(t('Synchronization will restore all the Products again from your Premium Web Cart Merchant Account to your PWC Store.'), 'warning');
		/*drupal_set_message(t('Synchronization will delete all the categories & products (including Product Option Group & Options) from your Store Site.<br/>We will be not able to recover them again for you anyhow.'), 'warning');
		*/
	}
	$output = '';
	$output .= drupal_get_form('pwcs_admin_sync_form');
	return $output;
}


