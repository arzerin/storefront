/** <<end Define variables **/

/**
 * Jquery UI JS and CSS import
 * Added by Rasel Kabir
 */
if (module_exists('jquery_ui'))
{
	// By default PWCS module search for jquery theme at your theme folder "YOURTHEME/jqueryui/jquery-ui.css" path. 
	// If there is no such directory like "YOURTHEME/jqueryui/jquery-ui.css" then there will be no theme selected.
	$current_theme = ($user->theme)?$user->theme:variable_get('theme_default','none');
	if(file_exists(drupal_get_path('theme', $current_theme).'/jqueryui/jquery-ui.css')){
		$jQueryUI_css = drupal_get_path('theme', $current_theme).'/jqueryui/jquery-ui.css';
		drupal_add_css($jQueryUI_css, 'theme');
	} else {
		// No theme selected.
		$jQueryUI_css = drupal_get_path('module', 'jquery_ui').'/jquery.ui/themes/ui-lightness/jquery-ui-1.7.3.custom.css';
		drupal_add_css($jQueryUI_css, 'theme');
	}
	drupal_add_js(drupal_get_path('module', 'jquery_ui') .'/jquery-ui-1.7.3.custom.min.js', 'core', 'header');
}

