	$items['manufacturers'] = array(
		'page callback' => 'pwcs_public_manufacturers_url',
		'access callback' => true,
	);

	$items['login'] = array(
    	'page callback' => 'user_login_page',
		'title' => t('User Login Page'),
    	'access callback' => TRUE,
    	'type' => MENU_CALLBACK,
	);


	$items['resetcart'] = array(
		'page callback' => 'pwcs_resetcart',
		'access callback' => true,
		'type' => MENU_CALLBACK,
	);

	$items['cartinfo'] = array(
		'page callback' => 'pwcs_cartinfo',
		'access callback' => true,
		'type' => MENU_CALLBACK,
	);
	$items['pwcsajax/cartinfo'] = array(
