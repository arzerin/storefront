	);

	//Socialmedia Settings
	/*
	$items['siteadmin/socialmedia'] = array(
		'title' => 'Social Media Settings',
		'page callback' => 'drupal_get_form',
		'page arguments' => array('pwcs_siteadmin_socialmedia'),
		'type' => MENU_CALLBACK,
		'access arguments' => array('is siteadmin'),
	);
	*/
	$items['siteadmin/socialmedia'] = array(
		'title' => 'Social Media Settings',
		'page callback' => 'pwcs_siteadmin_socialmedia_page',
