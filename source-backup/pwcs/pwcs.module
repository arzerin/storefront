		'#description' => t('URL from where PWC Store will do the functionality of remove from cart at PWC Core'),
		'#default_value' => variable_get('pwcs_target_url_removefromcart', 'api/removeFromCart.html') ,
		'#maxlength' => 180,
		//'#style'=> 'width: 250px;'
	);

	$form['variable_settings']['target_urls']['pwcs_target_url_getcartinfo'] = array(
