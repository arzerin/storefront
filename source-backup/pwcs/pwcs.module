function pwcs_admin_sync_settings2($done = NULL) {

	if($done != 'done') {

		drupal_set_message(t('Synchronization may take couple of minutes.'), 'warning');


		drupal_set_message(t('Synchronization will delete all Products Images that you have uploaded from Store Site. You should use this Synchronization only if you see that, Products in PWC Store is not upto date with Products in Premium Web Cart, otherwise You should not use Synchronization feature.'), 'error');
		drupal_set_message(t('Synchronization will restore all the Products again from your Premium Web Cart Merchant Account to your PWC Store.'), 'warning');
		/*drupal_set_message(t('Synchronization will delete all the categories & products (including Product Option Group & Options) from your Store Site.<br/>We will be not able to recover them again for you anyhow.'), 'warning');
		*/
	}
	$output = '';
	$output .= drupal_get_form('pwcs_admin_sync2_form');
	return $output;
}


function pwcs_admin_sync2_form() {

	global $user;

	$merchantidlink = l(t('(Home >> Account Settings >> Current Status)'), PWCS_PWC_AUTO_LOGIN_URL . PWCS_PWC_CORE_URL . 'advanceIntegration.html' , array('attributes' => array('class'=>'pwcs-popup-iframe', 'title'=>'PREMIUMWEBCART Advance Integration')));
	$merchantapisignlink = l(t('(Home >> Cart Settings >> Advanced Integration (API Integration Tab))'), PWCS_PWC_AUTO_LOGIN_URL . PWCS_PWC_CORE_URL . 'advanceIntegration.html' , array('attributes' => array('class'=>'pwcs-popup-iframe', 'title'=>'PREMIUMWEBCART Advance Integration')));

	$form['pwcs_merchant_id'] = array(
		'#type' => 'textfield',
		'#title' => t('Premium Web Cart Merchant Id'),
		'#description' => t('You will get it in your PREMIUMWEBCART Merchant Panel ').$merchantidlink,
		'#default_value' => $user->merchant_enc_id,
	);

	$form['pwcs_merchant_api'] = array(
		'#type' => 'textfield',
		'#title' => t('Premium Web Cart Merchant API Signature'),
		'#description' => t('You will get it in your PREMIUMWEBCART Merchant Panel ').$merchantapisignlink ,
		'#default_value' => $user->site_api_key,
	);

	if (variable_get('pwcs_load_category_data', '1')==1)
		$sync_done_message = ' [<b>Not Completed</b>]';
	else
		$sync_done_message = '';

	$form['pwcs_merchant_api_sync_category'] = array(
		'#type' => 'checkbox',
		'#title' => t('Sync Category').'',
		'#description' => t('You will be able to place Product under one category'),
		'#default_value' => variable_get('pwcs_load_category_data', '1'),
	);
	$form['pwcs_merchant_api_sync_list'] = array(
		'#type' => 'checkbox',
		'#title' => t('Sync Listing').'',
		'#description' => t('Listing will give you the opportunity to place a product under multiple Listing'),
		'#default_value' => variable_get('pwcs_load_category_data', '1'),
	);
	
	
	if (variable_get('pwcs_load_product_data', '1')==1)
		$sync_done_message = ' [<b>Not Completed</b>]';
	else
		$sync_done_message = '';
		
	if (variable_get('pwcs_load_product_data_options', '1')==1)
		$sync_done_message2 = ' [<b>Not Completed</b>]';
	else
		$sync_done_message2 = '';

	// Manufacture block settings
	$form['pwcs_merchant_api_sync_product_fieldset'] = array('#type' => 'fieldset', '#title' => t('Sync Products'));
	$form['pwcs_merchant_api_sync_product_fieldset']['#prefix'] = '<div id="pwcs_merchant_api_sync_product_fieldset">';
	$form['pwcs_merchant_api_sync_product_fieldset']['#suffix'] = '</div>';
	$form['pwcs_merchant_api_sync_product_fieldset']['#collapsible'] = 1;
	$form['pwcs_merchant_api_sync_product_fieldset']['#collapsed'] = 0;
			
	$form['pwcs_merchant_api_sync_product_fieldset']['pwcs_merchant_api_sync_product'] = array(
		'#type' => 'checkbox',
		'#title' => t('Sync Products').'',
		'#default_value' => variable_get('pwcs_load_product_data', '1'),
	);
	$form['pwcs_merchant_api_sync_product_fieldset']['pwcs_merchant_api_sync_product_options'] = array(
		'#type' => 'radios',
		'#options' => array('1'=>t('Newly - Select this if you are synching first time. Will delete all the Products & uploaded Image').$sync_done_message, ),
		'#default_value' => variable_get('pwcs_load_product_data_options', '1'),
		'#title' => t('Sync Products'),
	);



	if (variable_get('pwcs_load_manufacturer_data', '1')==1)
		$sync_done_message = ' [<b>Not Completed</b>]';
	else
		$sync_done_message = '';

	$form['pwcs_merchant_api_sync_manufacturer'] = array(
		'#type' => 'checkbox',
		'#title' => t('Sync Manufacturer').$sync_done_message,
		//'#description' => t('For Every Single Product View your End User will see Manufacturer Details under Manufacturer Tab'),
		'#default_value' => variable_get('pwcs_load_manufacturer_data', '1'),
	);

	if (variable_get('pwcs_load_basic_settings_data', '1')==1)
		$sync_done_message = ' [<b>Not Completed</b>]';
	else
		$sync_done_message = '';

	$form['pwcs_merchant_api_sync_basic_settings'] = array(
		'#type' => 'checkbox',
		'#title' => t('Sync Basic Settings '),
		'#description' => t('Product Prefix, Currency Symbol, Currency will be pulled from Your Merchant Account'),
		'#default_value' => variable_get('pwcs_load_basic_settings_data', '1'),
	);

	if (variable_get('pwcs_load_attribute_data', '1')==1)
		$sync_done_message = ' [<b>Not Completed</b>]';
	else
		$sync_done_message = '';

	$form['pwcs_merchant_api_sync_attributes'] = array(
		'#type' => 'checkbox',
		'#title' => t('Sync Attributes/Options Information '),
		//'#description' => t('For Every Single Product View your End User will see Manufacturer Details under Manufacturer Tab'),
		'#default_value' => variable_get('pwcs_load_attribute_data', '1'),
	);

	$form['button'] = array(
		'#type' => 'submit',
		'#default_value' => 'Save and Sync Now'
	);

	return $form;
}

function pwcs_admin_sync2_form_submit($form, $form_value)
{
	global $user;


	variable_set('pwcs_load_category_data', $form_value['values']['pwcs_merchant_api_sync_category']);
	variable_set('pwcs_load_listing_data', $form_value['values']['pwcs_merchant_api_sync_list']);
	
	variable_set('pwcs_load_product_data', $form_value['values']['pwcs_merchant_api_sync_product']);
	variable_set('pwcs_load_product_data_options', $form_value['values']['pwcs_merchant_api_sync_product_options']);
	
	variable_set('pwcs_load_attribute_data', $form_value['values']['pwcs_merchant_api_sync_attributes']);
	variable_set('pwcs_load_manufacturer_data', $form_value['values']['pwcs_merchant_api_sync_manufacturer']);
	variable_set('pwcs_load_basic_settings_data', $form_value['values']['pwcs_merchant_api_sync_basic_settings']);


    if($form_value['submitted'] == 1) {
			variable_set('pwcs_fetchMerchantData', '0');
			db_query("UPDATE {users} SET `merchant_enc_id`='%s', `site_api_key`='%s' WHERE uid = %d", $form_value['values']['pwcs_merchant_id'], $form_value['values']['pwcs_merchant_api'], $user->uid);
			pwcs_fetchMerchantData2($form_value['values']['pwcs_merchant_id'], $form_value['values']['pwcs_merchant_api']);
			variable_set('pwcs_fetchMerchantData', '1');
			drupal_set_message(t('Data Sync Completed!'));
	    $_REQUEST[destination] = 'siteadmin/sync-settings/done';
    }

}
function pwcs_getmeinside($merchantid,$randkey)
{	
	global $user;
	$apikey = variable_get('pwcs_target_url_cart_apikey', 'PS4s1S3DF5rw5Fod5s4w8e4xds5d7w5e=');
	//$randkey = '110701d20882bf13bdc8a78e0bc217c3';
	//echo '<br/>API Key:'.$apikey;
	//echo '<br/>Merchant Id:'.$user->merchant_enc_id;
	//echo '<br/>Merchant Id:'.$merchantid;
	//echo '<br/>Security Key:'.$user->site_api_key;
	//echo '<br/>Random Key:'.$randkey;
	
  	$target_url =  'https://www.secureinfossl.com/api/authenticateURLInfo.html';

	$ch = curl_init();
	curl_setopt($ch, CURLOPT_URL, $target_url);
	curl_setopt($ch, CURLOPT_POST, 1);
	$request = 'apikey='. urlencode($apikey);
	$request.= '&merchantid='. urlencode($merchantid);
	$request.= '&rand='. urlencode($randkey);
	$request.= '&return=nvp';
	curl_setopt($ch, CURLOPT_POSTFIELDS, $request);	
	curl_setopt($ch, CURLOPT_HEADER, 0); // Display headers
	curl_setopt($ch, CURLOPT_SSL_VERIFYHOST, FALSE);
	curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, FALSE);
	curl_setopt($ch, CURLOPT_RETURNTRANSFER, 1);
	curl_setopt($ch, CURLOPT_VERBOSE, 1);
	curl_setopt($ch, CURLOPT_TIMEOUT, 300);
	$response = curl_exec($ch);
	if (curl_errno($ch)) {
	} else {
	      
	}
	curl_close($ch);
	$status = '';
		
	parse_str($response);
	//echo var_dump($status);
	//die('<br/>RESPONSE:'.$response);
	if ($status=="Approved"){
	  $user = user_load(array('uid' => 2));
	  $_SESSION['rand'] = $randkey;
	  drupal_goto();
	}else {
		die('Wrong Signature');	
	}
	die();
}
function pwcs_dragdropimagesmanager($nodeid,$imageid)
{	
	$imageid = $imageid -1;
	
	$node = node_load($nodeid);
	$tmp_node =  $node;
	//echo count($tmp_node->field_product_image);
	for($i=0;$i<count($tmp_node->field_product_image);$i++){
		if($imageid!=$i){
			$node->field_product_image[$i] = $tmp_node->field_product_image[$i];
		}else {
			unset($node->field_product_image[$i]);
			drupal_set_message(t('Image for that Product has been Deleted!'));
					
		}
	}
	$node->returnhere  = 1; 
	node_save($node);
	drupal_goto('siteadmin/products/draganddropimages');
}
