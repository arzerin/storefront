		//'#style'=> 'width: 250px;'
	);

	$form['variable_settings']['target_urls']['pwcs_target_url_checkout'] = array(
		'#type' => 'textfield',
		'#title' => t('Check Out URL'),
		'#description' => t('Check Out URL to PWC Core'),
