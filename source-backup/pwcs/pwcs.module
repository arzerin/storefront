	$items['siteadmin/tools'] = array(
		'title' => 'Tools',
		'page callback' => 'pwcs_siteadmin_tools_page',
		'access arguments' => array('is siteadmin'),
		'type' => MENU_CALLBACK,
		
	);	
	//Siteadmin End

	//Public URL START
	$items['products'] = array(
		'page callback' => 'pwcs_public_products_url',
		'access callback' => true,
	);

	$items['listing-products'] = array(
		'page callback' => 'pwcs_public_list_products_url',
		'access callback' => true,
	);
	//$items['categories'] = array(
	//	'page callback' => 'pwcs_public_categories_url',
	//	'access callback' => true,
