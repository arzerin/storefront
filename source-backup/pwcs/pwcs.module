/**
 * Settings page for Siteadmin Socialmedia
 * @return form array for siteadmin Socialmedia
 * Added by Rasel Kabir <shuvro.mist@gmail.com>
 */
function pwcs_siteadmin_socialmedia() {

	$form['socialmedia_urls'] = array('#type' => 'fieldset', '#title' => t('Social Media URLs'));
	$form['socialmedia_urls']['#collapsible'] = 0;
	$form['socialmedia_urls']['#collapsed'] = 0;

	$form['socialmedia_urls']['pwcs_socialmedia_url_facebook'] = array(
		'#type' => 'textfield',
		'#title' => t('Facebook Page URL'),
		'#description' => t('Your Facebook Page URL, Example: http://facebook.com/premiumwebcart'),
