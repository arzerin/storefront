function theme_pwcs_siteadmin_dashboard_item($title, $type='', $link='', $linkclass='', $linktitle='') {
	$item_html = '<div class="sd_item_inner"> <div class="image '.$type.'"></div> <div class="text">'.t($title).'</div> </div>';
