/**
 * Implementation of hook_block().
 * Added by Rasel Kabir
 */
function pwcs_block($op = 'list', $delta = 0, $edit = array())
{
	if ($op == 'list')
	{
		$blocks['sidebar_category_menu']['info'] = t('Category Menu');
		$blocks['sidebar_category_menu']['weight'] = -10;
		//$blocks['sidebar_category_menu']['status'] = 1; // 1 = enabled, 0 = disabled
		//$blocks['sidebar_category_menu']['region'] = 'sidebar_first';

	  $blocks['sidebar_listing_menu']['info'] = t('Listings Menu');
		$blocks['sidebar_listing_menu']['weight'] = -8;
		//$blocks['sidebar_listing_menu']['status'] = 0; // 1 = enabled, 0 = disabled
		//$blocks['sidebar_listing_menu']['region'] = 'sidebar_first';

		$blocks['sidebar_manufacture_block']['info'] = t('Manufacture Menu');
		$blocks['sidebar_manufacture_block']['weight'] = -9;
		//$blocks['sidebar_manufacture_block']['status'] = 1; // 1 = enabled, 0 = disabled
		//$blocks['sidebar_manufacture_block']['region'] = 'sidebar_first';

		$blocks['homepage_products']['info'] = t('Home Products');
		$blocks['homepage_products']['weight'] = -10;
		//$blocks['homepage_products']['status'] = 1; // 1 = enabled, 0 = disabled
		//$blocks['homepage_products']['region'] = 'content';
		$blocks['homepage_products']['visibility'] = 1;  //0: Show on all pages except listed pages. 'homepage_products': Show only on listed pages. 2: Use custom PHP code to determine visibility.
		$blocks['homepage_products']['pages'] = '<front>';

		$blocks['siteadmin_navigation']['info'] = t('Siteadmin Navigation');
		$blocks['siteadmin_navigation']['weight'] = -10;
		//$blocks['siteadmin_navigation']['status'] = 1; // 1 = enabled, 0 = disabled
		//$blocks['siteadmin_navigation']['region'] = 'left';

		$blocks['siteadmin_navigation_top']['info'] = t('Siteadmin Header Navigation');
		$blocks['siteadmin_navigation_top']['weight'] = -10;
		//$blocks['siteadmin_navigation_top']['status'] = 1; // 1 = enabled, 0 = disabled
		//$blocks['siteadmin_navigation_top']['region'] = 'header_menu';

		$blocks['header_banner']['info'] = t('Header Banner');
		$blocks['header_banner']['weight'] = -10;
		//$blocks['header_banner']['status'] = 1; // 1 = enabled, 0 = disabled
		//$blocks['header_banner']['region'] = 'header';

		$blocks['welcome_text']['info'] = t('Welcome Text');
		$blocks['welcome_text']['weight'] = -10;
		//$blocks['welcome_text']['status'] = 1; // 1 = enabled, 0 = disabled
		//$blocks['welcome_text']['region'] = 'preface-bottom';

		if(variable_get('pwcs_admin_enable_imageslideshow', 0) == 1) {
		  $blocks['image_slideshow']['info'] = t('Image Slideshow');
		  $blocks['image_slideshow']['weight'] = -10;
		  //$blocks['image_slideshow']['status'] = 1; // 1 = enabled, 0 = disabled
		  //$blocks['image_slideshow']['region'] = 'preface-top';
		}

		$blocks['cart_link']['info'] = t('Cart');
		$blocks['cart_link']['weight'] = -9;
		//$blocks['cart_link']['status'] = 1; // 1 = enabled, 0 = disabled
		//$blocks['cart_link']['region'] = 'header';

		$blocks['fatured_products']['info'] = t('Featured Products');
		$blocks['fatured_products']['weight'] = -9;
		//$blocks['fatured_products']['status'] = 1; // 1 = enabled, 0 = disabled
		//$blocks['fatured_products']['region'] = 'right';

		$blocks['sitesearch_input']['info'] = t('Site Search');
		$blocks['sitesearch_input']['weight'] = -10;
		//$blocks['sitesearch_input']['status'] = 1; // 1 = enabled, 0 = disabled
		//$blocks['sitesearch_input']['region'] = 'header';

		$blocks['topsearch_keywords']['info'] = t('Top Search Keywords');
		$blocks['topsearch_keywords']['weight'] = -10;
		//$blocks['topsearch_keywords']['status'] = 1; // 1 = enabled, 0 = disabled
		//$blocks['topsearch_keywords']['region'] = 'postscript_bottom';

		$blocks['socialmedia']['info'] = t('Social Media');
		$blocks['socialmedia']['weight'] = -10;
		//$blocks['socialmedia']['status'] = 1; // 1 = enabled, 0 = disabled
		//$blocks['socialmedia']['region'] = 'footer';

		$blocks['simplevideo']['info'] = t('Simple Video');

		return $blocks;
	}

	else if ($op == 'configure') {

		switch($delta)
		{
			case 'sidebar_category_menu':
			break;

			case 'homepage_products':
				$form['pwcs_homepage_products_block_amount'] = array(
					'#type' => 'textfield',
					'#title' => t('Number of products per page'),
					'#default_value' => variable_get('pwcs_homepage_products_block_amount', 10),
				);
				$form['pwcs_homepage_products_block_featured'] = array(
					'#type' => 'checkbox',
					'#title' => t('Show Only Featured Products'),
					'#default_value' => variable_get('pwcs_homepage_products_block_featured', 1),
				);
				//variable_get('pwcs_homepage_products_block_theme', 'spv_normal')
				$form['pwcs_psv_options'] = array('#type' => 'fieldset', '#title' => t('Product View Settings for Category/Listings'));
				$form['pwcs_psv_options']['#prefix'] = '<div id="pwcs_psv_options">';
				$form['pwcs_psv_options']['#suffix'] = '</div>';
				$form['pwcs_psv_options']['#collapsible'] = 1;
				$form['pwcs_psv_options']['#collapsed'] = 1;
				$product_block_themes = pwcs_product_single_view_options();
				$form['pwcs_psv_options']['pwcs_homepage_products_block_theme'] = array(
					'#type' => 'radios',
					'#options' => $product_block_themes,
					'#title' => t('View Theme'),
					'#description' => t('Selected theme will shown for homepage products block'),
					'#default_value' => variable_get('pwcs_homepage_products_block_theme', 'spv_normal'),
				);


			break;

			case 'header_banner':

				$form['pwcs_headerbanner_image_formset']['#prefix'] = '<div class="pwcs_headerbanner_image_formset">';
				$form['pwcs_headerbanner_image_formset']['#suffix'] = '</div>';
				$header_banner_output = '<div id="pwcs-header-banner-add-image-preview" class="pwcs-item-preview">'.variable_get('pwcs_headerbanner_image', '').'</div>'
																.'<a class="button" id="pwcs-header-banner-add-image">Add Header Image</a> <a class="button" id="pwcs-header-banner-add-image-remove">Remove</a>';
				$form['pwcs_headerbanner_image_formset']['pwcs_headerbanner_image_link'] = array(
					'#type' => 'markup',
					'#value' => $header_banner_output,
				);
				$form['pwcs_headerbanner_image_formset']['pwcs_headerbanner_image'] = array(
					'#type' => 'hidden',
					'#default_value' => variable_get('pwcs_headerbanner_image', ''),
				);

				$form['pwcs_headerbanner_text'] = array(
					'#type' => 'textarea',
					'#default_value' => variable_get('pwcs_headerbanner_text', ''),
					'#title' => t('Banner Text / Welcome Text'),
					'#description' => t('Banner Text / Welcome Text will show on banner image'),
				);

				$banner_text_poositions = array('left'=>'Left', 'center'=>'Center', 'right'=>'Right');
				$form['pwcs_headerbanner_text_position'] = array(
					'#type' => 'radios',
					'#options' => $banner_text_poositions,
					'#default_value' => variable_get('pwcs_headerbanner_text_position', 'left'),
					'#title' => t('Text Position'),
				);
			break;


			case 'welcome_text':
				$form['pwcs_welcome_text_title'] = array(
					'#type' => 'textfield',
					'#default_value' => variable_get('pwcs_welcome_text_title', 'Welcome to our Online Store'),
					'#title' => t('Welcome Text Title'),
					'#description' => t('Title of Welcome text'),
				);
				$form['pwcs_welcome_text_content'] = array(
					'#type' => 'textarea',
					'#default_value' => variable_get('pwcs_welcome_text_content', 'Welcome to our online store. We hope and wish you a nice and comfortable experience with our online presentation.'),
					'#title' => t('Welcome Text Content'),
					'#description' => t('Content for Welcome Text'),
				);

			break;
			case 'image_slideshow':

				$form['imageslideshow_options']['pwcs_image_slideshow_slidertype'] = array(
					'#type' => 'radios',
					'#options' => array('ordinary'=>'Ordinary Slider', 'special'=>'New Slider with Sliding effects'),
					'#default_value' => variable_get('pwcs_image_slideshow_slidertype', 'ordinary'),
					'#title' => t('Slider Type'),
				);
				$form['imageslideshow_options']['sp_options'] = array('#type' => 'fieldset', '#title' => t('Slideshow Options for New Slider'));
				$form['imageslideshow_options']['sp_options']['#prefix'] = '<div id="sp_options">';
				$form['imageslideshow_options']['sp_options']['#suffix'] = '</div>';
				$form['imageslideshow_options']['sp_options']['#collapsible'] = 1;
				$form['imageslideshow_options']['sp_options']['#collapsed'] = 1;

				$form['imageslideshow_options']['sp_options']['pwcs_image_slideshow_arrows'] = array(
					'#type' => 'radios',
					'#options' => array('true'=>'Yes', 'false'=>'No'),
					'#default_value' => variable_get('pwcs_image_slideshow_arrows', 'true'),
					'#title' => t('Previous Next Arrows'),
				);
				$form['imageslideshow_options']['sp_options']['pwcs_image_slideshow_navigation'] = array(
					'#type' => 'radios',
					'#options' => array('true'=>'Yes', 'false'=>'No'),
					'#default_value' => variable_get('pwcs_image_slideshow_navigation', 'false'),
					'#title' => t('Navigation Buttons'),
				);
				$form['imageslideshow_options']['sp_options']['pwcs_image_slideshow_startstop'] = array(
					'#type' => 'radios',
					'#options' => array('true'=>'Yes', 'false'=>'No'),
					'#default_value' => variable_get('pwcs_image_slideshow_startstop', 'false'),
					'#title' => t('Start/Stop Button'),
				);
				$form['imageslideshow_options']['sp_options']['pwcs_image_slideshow_autoplay'] = array(
					'#type' => 'radios',
					'#options' => array('true'=>'Yes', 'false'=>'No'),
					'#default_value' => variable_get('pwcs_image_slideshow_autoplay', 'true'),
					'#title' => t('Auto Play'),
				);
				$form['imageslideshow_options']['sp_options']['pwcs_image_slideshow_speed'] = array(
					'#type' => 'select',
					'#options' => array('1000'=>t('1 Second'), '2000'=>t('2 Seconds'), '3000'=>t('3 Seconds'), '4000'=>t('4 Seconds'), '5000'=>t('5 Seconds')),
					'#default_value' => variable_get('pwcs_image_slideshow_speed', '3000'),
					'#title' => t('Sliding Speed'),
				);

				$form['imageslideshow_options']['pwcs_image_slideshow_width'] = array(
					'#type' => 'textfield',
					'#default_value' => variable_get('pwcs_image_slideshow_width', '650'),
					'#title' => t('Width'),
					'#size'=> 8,
					'#field_suffix' => 'px',
				);
				$form['imageslideshow_options']['pwcs_image_slideshow_height'] = array(
					'#type' => 'textfield',
					'#default_value' => variable_get('pwcs_image_slideshow_height', '250'),
					'#title' => t('Height'),
					'#size'=> 8,
					'#field_suffix' => 'px',
				);
				$poositions = array('left'=>'Left', 'center'=>'Center', 'right'=>'Right');
				$form['imageslideshow_options']['pwcs_image_slideshow_position'] = array(
					'#type' => 'radios',
					'#options' => $poositions,
					'#default_value' => variable_get('pwcs_image_slideshow_position', 'center'),
					'#title' => t('Position'),
				);

				$imageslideshow_nid = _pwcs_getnid_from_path('siteadmin/imageslideshow');
				$form['pwcs_image_slideshow_tips'] = array(
					'#type' => 'markup',
					//'#value' => '<div class="messages">'.t('NB: To Add/Edit/Delete Images, Go To !siteadmin-slideshow', array('!siteadmin-slideshow' => l(t('Siteadmin Slideshow'), 'node/'.$imageslideshow_nid.'/edit', array( 'attributes' => array('target' => '_blank',))))).'</div>',
					'#value' => '<div class="messages">'.t('NB: To Add/Edit/Delete Images, Go To !siteadmin-slideshow', array('!siteadmin-slideshow' => l(t('Siteadmin Slideshow'), 'node/'.$imageslideshow_nid.'/edit', array('query' => 'destination=admin/build/block/configure/pwcs/image_slideshow?destination=admin%2Fbuild%2Fblock', 'attributes' => array())))).'</div>',
				);

			break;

			case 'fatured_products':
				$form['pwcs_fatured_products_block_amount'] = array(
					'#type' => 'textfield',
					'#title' => t('Number of products will be shown'),
					'#default_value' => variable_get('pwcs_fatured_products_block_amount', 6),
				);

				//variable_get('pwcs_fatured_products_block_theme', 'spv_normal')
				$form['pwcs_psv_options'] = array('#type' => 'fieldset', '#title' => t('Product View Settings for Featured Products'));
				$form['pwcs_psv_options']['#prefix'] = '<div id="pwcs_psv_options">';
				$form['pwcs_psv_options']['#suffix'] = '</div>';
				$form['pwcs_psv_options']['#collapsible'] = 1;
				$form['pwcs_psv_options']['#collapsed'] = 1;
				$product_block_themes = pwcs_product_single_view_options();
				$form['pwcs_psv_options']['pwcs_fatured_products_block_theme'] = array(
					'#type' => 'radios',
					'#options' => $product_block_themes,
					'#title' => t('Theme '),
					'#description' => t('Selected theme will shown for featured products block'),
					'#default_value' => variable_get('pwcs_fatured_products_block_theme', 'spv_normal'),
				);

			break;

			case 'topsearch_keywords':
				$form['pwcs_topsearch_keywords_themetype'] = array(
					'#type' => 'radios',
					'#options' => array(0=>t('List Type'), 1=>t('Cloud Type')),
					'#title' => t('Top Search Theme Type'),
					'#default_value' => variable_get('pwcs_topsearch_keywords_themetype', 1),
				);
			break;

			case 'socialmedia':
//				$form['pwcs_socialmedia_icon_text'] = array(
//					'#type' => 'radios',
//					'#options' => array(0=>t('Icon'), 1=>t('Text')),
//					'#title' => t('Show Icon / Text'),
//					'#default_value' => variable_get('pwcs_socialmedia_icon_text', 1),
//				);
			break;

			case 'simplevideo':

				$form['pwcs_simplevideo_url'] = array(
					'#type' => 'textfield',
					'#title' => t('Video URL'),
					'#default_value' => variable_get('pwcs_simplevideo_url', ''),
					'#description' => t('Youtube URL, Example: http://www.youtube.com/watch?v=tGk5ioEXlIM'),
				);
				$form['pwcs_simplevideo_width'] = array(
					'#type' => 'textfield',
					'#title' => t('Video Width'),
					'#default_value' => variable_get('pwcs_simplevideo_width', 220),
				);
				$form['pwcs_simplevideo_height'] = array(
					'#type' => 'textfield',
					'#title' => t('Video Height'),
					'#default_value' => variable_get('pwcs_simplevideo_height', 160),
				);

			break;

		}
		return $form;
	}

	else if ($op == 'save') {
		switch($delta)
		{
			case 'homepage_products':
				variable_set('pwcs_homepage_products_block_amount', $edit['pwcs_homepage_products_block_amount']);
				variable_set('pwcs_homepage_products_block_featured', $edit['pwcs_homepage_products_block_featured']);
				variable_set('pwcs_homepage_products_block_theme', $edit['pwcs_homepage_products_block_theme']);
			break;

			case 'header_banner':
				variable_set('pwcs_headerbanner_image', $edit['pwcs_headerbanner_image']);
				variable_set('pwcs_headerbanner_text_position', $edit['pwcs_headerbanner_text_position']);
				variable_set('pwcs_headerbanner_text', $edit['pwcs_headerbanner_text']);
			break;

			case 'welcome_text':
				variable_set('pwcs_welcome_text_title', $edit['pwcs_welcome_text_title']);
				variable_set('pwcs_welcome_text_content', $edit['pwcs_welcome_text_content']);
			break;

			case 'image_slideshow':
				//variable_set('pwcs_image_slideshow_image', $edit['pwcs_image_slideshow_image']);
				variable_set('pwcs_image_slideshow_slidertype', $edit['pwcs_image_slideshow_slidertype']);
				variable_set('pwcs_image_slideshow_width', $edit['pwcs_image_slideshow_width']);
				variable_set('pwcs_image_slideshow_height', $edit['pwcs_image_slideshow_height']);
				variable_set('pwcs_image_slideshow_position', $edit['pwcs_image_slideshow_position']);
				variable_set('pwcs_image_slideshow_arrows', $edit['pwcs_image_slideshow_arrows']);
				variable_set('pwcs_image_slideshow_navigation', $edit['pwcs_image_slideshow_navigation']);
				variable_set('pwcs_image_slideshow_startstop', $edit['pwcs_image_slideshow_startstop']);
				variable_set('pwcs_image_slideshow_speed', $edit['pwcs_image_slideshow_speed']);
				variable_set('pwcs_image_slideshow_autoplay', $edit['pwcs_image_slideshow_autoplay']);

			break;

			case 'fatured_products':
				variable_set('pwcs_fatured_products_block_amount', $edit['pwcs_fatured_products_block_amount']);
				variable_set('pwcs_fatured_products_block_theme', $edit['pwcs_fatured_products_block_theme']);
			break;

			case 'topsearch_keywords':
				variable_set('pwcs_topsearch_keywords_themetype', $edit['pwcs_topsearch_keywords_themetype']);
			break;

			case 'socialmedia':
				//variable_set('pwcs_socialmedia_icon_text', $edit['pwcs_socialmedia_icon_text']);
			break;

			case 'simplevideo':
				variable_set('pwcs_simplevideo_url', $edit['pwcs_simplevideo_url']);
				variable_set('pwcs_simplevideo_width', $edit['pwcs_simplevideo_width']);
				variable_set('pwcs_simplevideo_height', $edit['pwcs_simplevideo_height']);
			break;

		}
	}

	else if ($op == 'view')
	{
		switch($delta)
		{
			case 'sidebar_category_menu':
				$block['subject'] = t('Category');
				$block['content'] = pwcs_category_menu();
			break;

			case 'sidebar_listing_menu':
				$block['subject'] = t('Listing');
				$block['content'] = pwcs_listing_menu();
			break;

			case 'sidebar_manufacture_block':
				$block['subject'] = t('Manufacturers');
				$block['content'] = pwcs_manufacture_menu_block();
			break;

			case 'homepage_products':
				$block['content'] = pwcs_public_products_block();
			break;

			case 'siteadmin_navigation':
					$block['content'] = pwcs_siteadmin_navigation();
			break;

			case 'siteadmin_navigation_top':
					$block['content'] = pwcs_siteadmin_navigation_top();
			break;

			case 'header_banner':
				$block['content'] = pwcs_header_banner_block();
			break;

			case 'welcome_text':
				$block['content'] = pwcs_welcome_text_block();
			break;

			case 'image_slideshow':
				if(variable_get('pwcs_image_slideshow_slidertype','ordinary') == 'ordinary') {
				  $block['content'] = pwcs_image_slideshow_block_ordinary();
				} else {
				  $block['content'] = pwcs_image_slideshow_block();
				}
			break;

			case 'cart_link':
				$block['content'] = pwcs_cart_block();
			break;

			case 'fatured_products':
				$block['subject'] = t('Featured');
				$block['content'] = pwcs_fatured_products();
			break;

			case 'sitesearch_input':
				$block['content'] = pwcs_sitesearch_input_block();
			break;

			case 'topsearch_keywords':
				$block['subject'] = t('Top Searches');
				$block['content'] = pwcs_topsearch_keywords_block();
			break;

			case 'socialmedia':
				$block['content'] = pwcs_socialmedia_block();
			break;

			case 'simplevideo':
				$block['content'] = pwcs_simplevideo_block();
			break;

		}
		return $block;
	}

}


