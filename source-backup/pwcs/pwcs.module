function pwcs_imagethumb_sql() {

	pwcs_imagecachepresetaction('spv_135x160', 'imagecache_scale_and_crop', 135, 160);
	pwcs_imagecachepresetaction('spv_85x85', 'imagecache_scale_and_crop', 85, 85);
	pwcs_imagecachepresetaction('spv_70x70', 'imagecache_scale_and_crop', 70, 70);
	pwcs_imagecachepresetaction('spv_100x100', 'imagecache_scale_and_crop', 100, 100);
	pwcs_imagecachepresetaction('spv_150xAuto', 'imagecache_scale', 150);
	pwcs_imagecachepresetaction('spv_200xAuto', 'imagecache_scale', 200);
	pwcs_imagecachepresetaction('spv_80xAuto', 'imagecache_scale', 80);
	pwcs_imagecachepresetaction('spv_260x260', 'imagecache_scale_and_crop', 260, 260);

}

function pwcs_imagecachepresetaction($presetname='', $action = 'imagecache_scale_and_crop', $width='', $height='', $upscale = 1){

    // Preset
    $imagecachepreset = new stdClass ();
    $imagecachepreset->presetname = $presetname;
    drupal_write_record('imagecache_preset', $imagecachepreset);

    // Action
    $imagecacheaction = new stdClass ();
    $imagecacheaction->presetid = $imagecachepreset->presetid;
    $imagecacheaction->module = 'imagecache';
    $imagecacheaction->action = $action;

    $data = array();
    $data['width'] = $width;
    $data['height'] = $height;
    if($action == 'imagecache_scale'){
   	 $data['upscale'] = $upscale;
    }
    $imagecacheaction->data = $data;
    drupal_write_record('imagecache_action', $imagecacheaction);
}


/**
 * Function to enable new static theme
 * Adde by Rasel Kabir
 */
function pwcs_updatesql_enablenewtheme($theme_name = '') {

	if($theme_name == '') return NULL;

    db_query("UPDATE {system} SET status = 1 WHERE type = 'theme' and name = '%s'", $theme_name);
    list_themes(TRUE);
    menu_rebuild();
    drupal_rebuild_theme_registry();
}

function pwcs_siteadmintheme_updatesql() {

	//Enable SITEADMIN NEW THEME
    $key = 'siteadmintheme';
    //db_update('system')->fields(array('status' => 1))->condition('type', 'theme')->condition('name', $key)->execute();
    //system_initialize_theme_blocks($key);
    db_query("UPDATE {system} SET status = 1 WHERE type = 'theme' and name = '%s'", $key);
    db_query("DELETE FROM {variable} WHERE name = 'theme_siteadmintheme_settings'");
    $theme_siteadmintheme_settings_value = 'a:24:{s:11:"toggle_logo";i:0;s:11:"toggle_name";i:0;s:13:"toggle_slogan";i:0;s:14:"toggle_favicon";i:1;s:12:"default_logo";i:1;s:9:"logo_path";s:0:"";s:11:"logo_upload";s:0:"";s:15:"default_favicon";i:1;s:12:"favicon_path";s:0:"";s:14:"favicon_upload";s:0:"";s:10:"theme_grid";s:10:"grid16-960";s:16:"fluid_grid_width";s:8:"fluid-95";s:14:"sidebar_layout";s:14:"sidebars-split";s:19:"sidebar_first_width";s:1:"4";s:18:"sidebar_last_width";s:1:"2";s:10:"theme_font";s:4:"none";s:15:"theme_font_size";s:12:"font-size-12";s:21:"primary_menu_dropdown";i:0;s:18:"breadcrumb_display";i:1;s:24:"user_notverified_display";i:1;s:17:"block_config_link";i:0;s:9:"grid_mask";i:0;s:16:"rebuild_registry";i:0;s:13:"fix_css_limit";i:0;}';
    db_query("INSERT INTO {variable} ( `name` , `value` ) VALUES ( '%s', '%s')", 'theme_siteadmintheme_settings', $theme_siteadmintheme_settings_value);
	  variable_set('pwcs_theme_switch_set_block_'.$key, 0);
    list_themes(TRUE);
    menu_rebuild();
    drupal_rebuild_theme_registry();
	//variable_set('theme_default', $key);

	//REMOVE OTHERS BLOCK FOR SITEADMIN of pwcs_admin theme.
	db_query("UPDATE {blocks} SET status = 0 WHERE delta =  'siteadmin_navigation_top'");
	db_query("UPDATE {blocks} SET status = 1 WHERE delta =  'siteadmin_navigation_top' AND theme = 'siteadmintheme'");

	//REMOVE OTHERS BLOCK FOR SITEADMIN of pwcs_admin theme.
	db_query("UPDATE {blocks} SET status = 0 WHERE theme =  'pwcs_admin'");
	db_query("UPDATE {blocks} SET status = 1 WHERE delta =  'siteadmin_navigation' AND theme = 'pwcs_admin'");
}

/**
 * Siteadmin home page
 * Added by Rasel Kabir
 */
function pwcs_siteadmin(){

	global $user;
	drupal_set_title(t("Welcome @name", array('@name' => $user->name)));

	if($user->theme == 'pwcs_admin'){
		$button = l('Switch To New Theme', 'siteadmin/siteadmintheme/switch/siteadmintheme', array('html' => true, 'attributes' => array('class'=>'button', 'title'=>'Switch Siteadmin Theme to New One')));
		drupal_set_message('There\'s New User Interface For Site Admin Click The Button To Get The New One > '.$button);
	} else if($user->theme == 'siteadmintheme'){
		//$button = l('Switch Back To Old Theme', 'siteadmin/siteadmintheme/switch/pwcs_admin', array('html' => true, 'attributes' => array('class'=>'button', 'title'=>'Switch Siteadmin Theme to New One')));
		//drupal_set_message('To Switch Back To The Previous User Interface > '.$button);
		// Nothing for now
	} else {
		// No Theme Set
	}

	$output = '';
	$output .= theme_pwcs_siteadmin_dashboard();
	return $output;
}

